#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
LOG_FILE="${RESOURCE_PERFORMANCE_LOG:-${REPO_ROOT}/.build/resource-performance.log}"
OUTPUT_FILE="${RESOURCE_PERFORMANCE_JSONL:-${REPO_ROOT}/.build/resource-performance.jsonl}"
SWIFT_IMAGE="${SWIFT_IMAGE:-$("${SCRIPT_DIR}/swift-image")}"

mkdir -p "$(dirname "${OUTPUT_FILE}")"
commit_sha="${GITHUB_SHA:-$(git -C "${REPO_ROOT}" rev-parse HEAD 2>/dev/null || printf unknown)}"
runner_os="${RUNNER_OS:-$(uname -s)}"
runner_arch="${RUNNER_ARCH:-$(uname -m)}"

# These metadata values come from controlled CI/git identifiers. Strip quotes so the
# line remains valid JSON even when the script is exercised with custom local values.
commit_sha="${commit_sha//\"/}"
runner_os="${runner_os//\"/}"
runner_arch="${runner_arch//\"/}"
SWIFT_IMAGE="${SWIFT_IMAGE//\"/}"

printf '{"type":"metadata","commit_sha":"%s","swift_image":"%s","runner_os":"%s","runner_arch":"%s"}\n' \
  "${commit_sha}" "${SWIFT_IMAGE}" "${runner_os}" "${runner_arch}" > "${OUTPUT_FILE}"

if [ ! -f "${LOG_FILE}" ]; then
  exit 0
fi

awk '
  /^PERF_RESOURCE_SAMPLE / {
    operation = run = elapsed = throughput = user = system_cpu = rss = size = iterations = ""
    for (field_index = 2; field_index <= NF; field_index++) {
      split($field_index, pair, "=")
      if (pair[1] == "operation") operation = pair[2]
      if (pair[1] == "run") run = pair[2]
      if (pair[1] == "elapsed_ms") elapsed = pair[2]
      if (pair[1] == "throughput_mib_s") throughput = pair[2]
      if (pair[1] == "user_cpu_ms") user = pair[2]
      if (pair[1] == "system_cpu_ms") system_cpu = pair[2]
      if (pair[1] == "max_rss_kb") rss = pair[2]
      if (pair[1] == "total_size_mib") size = pair[2]
      if (pair[1] == "iterations") iterations = pair[2]
    }
    printf "{\"type\":\"sample\",\"operation\":\"%s\",\"run\":%s,\"elapsed_ms\":%s,\"throughput_mib_s\":%s,\"user_cpu_ms\":%s,\"system_cpu_ms\":%s,\"max_rss_kb\":%s,\"total_size_mib\":%s,\"iterations\":%s}\n", operation, run, elapsed, throughput, user, system_cpu, rss, size, iterations
  }
  /^PERF_RESOURCE [^ ]+ value=/ {
    name = $2
    value = size = runs = iterations = ""
    for (field_index = 3; field_index <= NF; field_index++) {
      split($field_index, pair, "=")
      if (pair[1] == "value") value = pair[2]
      if (pair[1] == "size_mib") size = pair[2]
      if (pair[1] == "runs") runs = pair[2]
      if (pair[1] == "iterations") iterations = pair[2]
    }
    printf "{\"type\":\"summary\",\"name\":\"%s\",\"value\":%s,\"size_mib\":%s,\"runs\":%s,\"iterations\":%s}\n", name, value, size, runs, iterations
  }
  /Maximum resident set size \(kbytes\)/ {
    value = $NF
    printf "{\"type\":\"process\",\"metric\":\"max_rss_kb\",\"value\":%s}\n", value
  }
' "${LOG_FILE}" >> "${OUTPUT_FILE}"
