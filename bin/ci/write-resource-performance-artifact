#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
LOG_FILE="${RESOURCE_PERFORMANCE_LOG:-${REPO_ROOT}/.build/resource-performance.log}"
OUTPUT_FILE="${RESOURCE_PERFORMANCE_JSONL:-${REPO_ROOT}/.build/resource-performance.jsonl}"
SWIFT_IMAGE="${SWIFT_IMAGE:-$("${SCRIPT_DIR}/swift-image")}"

mkdir -p "$(dirname "${OUTPUT_FILE}")"
temporary_directory="${TMPDIR:-/tmp}/swift-smbee-resource-artifact.$$"
mkdir -p "${temporary_directory}"
cleanup() {
  rm -rf "${temporary_directory}"
}
trap cleanup EXIT
metadata_file="${temporary_directory}/metadata.jsonl"
parsed_file="${temporary_directory}/parsed.jsonl"
failure_file="${temporary_directory}/failure.jsonl"
assembled_file="${temporary_directory}/assembled.jsonl"
commit_sha="${GITHUB_SHA:-$(git -C "${REPO_ROOT}" rev-parse HEAD 2>/dev/null || printf unknown)}"
runner_os="${RUNNER_OS:-$(uname -s)}"
runner_arch="${RUNNER_ARCH:-$(uname -m)}"
baseline_runs="${RESOURCE_BASELINE_RUNS:-1}"

python3 - "${metadata_file}" "${commit_sha}" "${SWIFT_IMAGE}" "${runner_os}" "${runner_arch}" "${baseline_runs}" <<'PY'
import json
import sys

output, commit_sha, swift_image, runner_os, runner_arch, baseline_runs = sys.argv[1:]
row = {
    "type": "metadata",
    "commit_sha": commit_sha,
    "swift_image": swift_image,
    "runner_os": runner_os,
    "runner_arch": runner_arch,
    "baseline_runs": int(baseline_runs),
}
with open(output, "w", encoding="utf-8") as stream:
    stream.write(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")
PY

if [ ! -f "${LOG_FILE}" ]; then
  mv "${metadata_file}" "${OUTPUT_FILE}"
  exit 0
fi

if "${SCRIPT_DIR}/parse-resource-performance" "${LOG_FILE}" >"${parsed_file}" 2>"${temporary_directory}/parse-error"; then
  cat "${metadata_file}" "${parsed_file}" >"${assembled_file}"
  mv "${assembled_file}" "${OUTPUT_FILE}"
  exit 0
fi

python3 - "${failure_file}" "${temporary_directory}/parse-error" <<'PY'
import json
import sys

output, error_file = sys.argv[1:]
error = open(error_file, encoding="utf-8").read().strip()
row = {"type": "parse_failure", "error": error}
with open(output, "w", encoding="utf-8") as stream:
    stream.write(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")
PY
cat "${metadata_file}" "${failure_file}" >"${assembled_file}"
mv "${assembled_file}" "${OUTPUT_FILE}"
exit 1
