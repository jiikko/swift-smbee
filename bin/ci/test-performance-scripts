test_compare_history() {
  local scenario_dir
  scenario_dir="$(new_scenario_dir)"
  write_docker_stub "${scenario_dir}"
  local log_file="${scenario_dir}/resource.log"
  local jsonl_file="${scenario_dir}/resource.jsonl"
  write_canonical_log "${log_file}"
  RESOURCE_PERFORMANCE_LOG="${log_file}" \
  RESOURCE_PERFORMANCE_JSONL="${jsonl_file}" \
  RESOURCE_BASELINE_RUNS=2 \
  SWIFT_IMAGE="swift:test" \
  GITHUB_SHA="0123456789abcdef" \
  GITHUB_RUN_ID="1234567890" \
  GITHUB_RUN_ATTEMPT="2" \
  RUNNER_OS="Linux" \
  RUNNER_ARCH="X64" \
  DOCKER_STUB_IMAGE_DIGEST='swift:test@sha256:deadbeef' \
  PATH="${scenario_dir}:${PATH}" \
    "${SCRIPT_DIR}/write-resource-performance-artifact"

  local compare_reference="${scenario_dir}/compare-reference.jsonl"
  local compare_metadata_mismatch="${scenario_dir}/compare-metadata-mismatch.jsonl"
  local compare_workload_mismatch="${scenario_dir}/compare-workload-mismatch.jsonl"
  local compare_parse_failure="${scenario_dir}/compare-parse-failure.jsonl"
  python3 - "${jsonl_file}" "${compare_reference}" "${compare_metadata_mismatch}" "${compare_workload_mismatch}" "${compare_parse_failure}" <<'PY'
import copy
import json
import sys
from decimal import Decimal

source, reference_path, metadata_path, workload_path, parse_failure_path = sys.argv[1:]
rows = [json.loads(line) for line in open(source, encoding="utf-8") if line.strip()]

reference = copy.deepcopy(rows)
for row in reference:
    if row.get("type") != "summary":
        continue
    metric = row["name"].split(".", 1)[1]
    value = Decimal(str(row["value"]))
    if metric == "throughput_mib_s":
        row["value"] = float(value / 2)
    elif metric in {"user_cpu_ms", "system_cpu_ms", "max_rss_kb"}:
        row["value"] = float(value * 2)

metadata_mismatch = copy.deepcopy(rows)
next(row for row in metadata_mismatch if row.get("type") == "metadata")["runner_os"] = "OtherOS"

workload_mismatch = copy.deepcopy(rows)
for row in workload_mismatch:
    if row.get("type") == "summary" and row["name"].startswith("read_stream."):
        row["size_mib"] = 999

parse_failure = [row for row in rows if row.get("type") == "metadata"]
parse_failure.append({"type": "parse_failure", "error": "fixture parse failure"})

for path, fixture in (
    (reference_path, reference),
    (metadata_path, metadata_mismatch),
    (workload_path, workload_mismatch),
    (parse_failure_path, parse_failure),
):
    with open(path, "w", encoding="utf-8") as stream:
        for row in fixture:
            stream.write(json.dumps(row, separators=(",", ":")) + "\n")
PY

  local compare_output="${scenario_dir}/compare-output.md"
  local compare_status=0
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${compare_reference}" \
    >"${compare_output}" || compare_status=$?
  test "${compare_status}" -eq 0
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${compare_output}" \
    '| `read_stream` | `throughput_mib_s` | 737.364 MiB/s | 368.682 MiB/s | improved (+100.0%) |' \
    '| `read_stream` | `user_cpu_ms` | 200.000 ms | 400.000 ms | improved (-50.0%) |' \
    '| `read_stream` | `system_cpu_ms` | 4.000 ms | 8.000 ms | improved (-50.0%) |' \
    '| `read_stream` | `max_rss_kb` | 286048.0 KiB | 572096.0 KiB | improved (-50.0%) |' \
    '| `write_stream` | `system_cpu_ms` | 0.000 ms | 0.000 ms | unchanged (±0.0%) |' \
    'Advisory only'
  if grep -Eq '✅|❌|Pass|Fail' "${compare_output}"; then
    echo 'comparison unexpectedly included guardrail status' >&2
    return 1
  fi

  local no_baseline_output="${scenario_dir}/no-baseline.md"
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${scenario_dir}/missing-reference.jsonl" \
    >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'No comparable baseline (reference JSONL is missing).'
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${compare_metadata_mismatch}" \
    >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'No comparable baseline (metadata mismatch: runner_os).'
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${compare_workload_mismatch}" \
    >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'No comparable baseline (workload mismatch: read_stream).'
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${compare_parse_failure}" \
    >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'No comparable baseline (reference JSONL contains parse_failure).'

  local baseline_summary="${scenario_dir}/baseline.md"
  "${SCRIPT_DIR}/summarize-resource-baseline" "${jsonl_file}" >"${baseline_summary}"
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${baseline_summary}" \
    '# SMBee resource performance baseline' \
    '| `read_stream.throughput_mib_s` | 2 | 737.364 | 737.364 | 737.364 | 0.000 | 0.0000 | 737.364 | 737.364 |' \
    '- first invocation (includes Release build): 666.1 MiB' \
    '- baseline invocations: 2'
}

test_parser_rejects_malformed() {
  local scenario_dir
  scenario_dir="$(new_scenario_dir)"
  local log_file="${scenario_dir}/resource.log"
  write_canonical_log "${log_file}"

  sed '/^PERF_RESOURCE_SAMPLE operation=read_stream run=1 /s/ iterations=20//' "${log_file}" > "${scenario_dir}/missing-field.log"
  expect_parser_failure "${scenario_dir}" missing-field "${scenario_dir}/missing-field.log"
  sed 's/elapsed_ms=245.000/elapsed_ms=not-a-number/' "${log_file}" > "${scenario_dir}/invalid-number.log"
  expect_parser_failure "${scenario_dir}" invalid-number "${scenario_dir}/invalid-number.log"
  sed 's/PERF_METRIC deterministic_command_count actual=12 expected=12/PERF_METRIC deterministic_command_count actual=12/' "${log_file}" > "${scenario_dir}/malformed-metric.log"
  expect_parser_failure "${scenario_dir}" malformed-metric "${scenario_dir}/malformed-metric.log"
  sed 's/PERF_METRIC deterministic_command_count actual=12 expected=12/PERF_METRIC deterministic_command_count actual=-1.25e+2 expected=2.5E2/' "${log_file}" > "${scenario_dir}/numeric-metric.log"
  "${SCRIPT_DIR}/parse-resource-performance" "${scenario_dir}/numeric-metric.log" >/dev/null
  cp "${log_file}" "${scenario_dir}/malformed.log"
  echo 'PERF_RESOURCE_SAMPLE malformed' >> "${scenario_dir}/malformed.log"
  expect_parser_failure "${scenario_dir}" malformed "${scenario_dir}/malformed.log"
  grep -v '^PERF_FORMAT ' "${log_file}" > "${scenario_dir}/missing-format.log"
  expect_parser_failure "${scenario_dir}" missing-format "${scenario_dir}/missing-format.log"
  sed 's/PERF_FORMAT version=1/PERF_FORMAT version=2/' "${log_file}" > "${scenario_dir}/wrong-format.log"
  expect_parser_failure "${scenario_dir}" wrong-format "${scenario_dir}/wrong-format.log"
  sed '/^PERF_RUN_COMPLETE operation=read_stream/d' "${log_file}" > "${scenario_dir}/missing-completion.log"
  expect_parser_failure "${scenario_dir}" missing-completion "${scenario_dir}/missing-completion.log"
  awk '/PERF_RESOURCE read_stream.throughput_mib_s value=737.364/ { print; print "PERF_RESOURCE read_stream.throughput_mib_s value=737.364 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release"; next } { print }' "${log_file}" > "${scenario_dir}/duplicate-metric.log"
  expect_parser_failure "${scenario_dir}" duplicate-metric "${scenario_dir}/duplicate-metric.log"
  awk '/PERF_RUN_COMPLETE operation=read_stream/ { print; print "PERF_RESOURCE_SAMPLE operation=read_stream run=1 elapsed_ms=245.000 throughput_mib_s=653.061 user_cpu_ms=200.000 system_cpu_ms=4.000 max_rss_kb=286048 total_size_mib=160 iterations=20"; next } { print }' "${log_file}" > "${scenario_dir}/resource-after-completion.log"
  expect_parser_failure "${scenario_dir}" resource-after-completion "${scenario_dir}/resource-after-completion.log"
  awk '/PERF_RUN_COMPLETE operation=read_stream/ { print; print "PERF_RESOURCE read_stream.throughput_mib_s value=737.364 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release"; next } { print }' "${log_file}" > "${scenario_dir}/summary-after-completion.log"
  expect_parser_failure "${scenario_dir}" summary-after-completion "${scenario_dir}/summary-after-completion.log"
  # PERF_FORMAT after the previous operation's completion is legitimate (each
  # resource test prints one), so the failure case is FORMAT after ALL
  # operations of the baseline run completed.
  awk '/PERF_RUN_COMPLETE operation=write_stream/ { print; print "PERF_FORMAT version=1"; next } { print }' "${log_file}" > "${scenario_dir}/format-after-completion.log"
  expect_parser_failure "${scenario_dir}" format-after-completion "${scenario_dir}/format-after-completion.log"
  cp "${log_file}" "${scenario_dir}/duplicate-baseline.log"
  echo 'PERF_BASELINE_RUN run=1 total=2' >> "${scenario_dir}/duplicate-baseline.log"
  expect_parser_failure "${scenario_dir}" duplicate-baseline "${scenario_dir}/duplicate-baseline.log"
  sed 's/PERF_BASELINE_RUN run=2 total=2/PERF_BASELINE_RUN run=3 total=2/' "${log_file}" > "${scenario_dir}/noncontinuous-baseline.log"
  expect_parser_failure "${scenario_dir}" noncontinuous-baseline "${scenario_dir}/noncontinuous-baseline.log"
  grep -v 'write_stream' "${log_file}" > "${scenario_dir}/missing-operation.log"
  expect_parser_failure "${scenario_dir}" missing-operation "${scenario_dir}/missing-operation.log"
  cp "${log_file}" "${scenario_dir}/duplicate-env.log"
  echo 'PERF_ENV kernel Duplicate kernel value' >> "${scenario_dir}/duplicate-env.log"
  expect_parser_failure "${scenario_dir}" duplicate-env "${scenario_dir}/duplicate-env.log"
}

test_summary_edge_cases() {
  local scenario_dir
  scenario_dir="$(new_scenario_dir)"
  local log_file="${scenario_dir}/resource.log"
  write_canonical_log "${log_file}"

  local zero_denominator_log="${scenario_dir}/zero-denominator.log"
  sed \
    -e 's/total_size_mib=160/total_size_mib=0/g' \
    -e 's/size_mib=160/size_mib=0/g' \
    -e 's/PERF_RESOURCE read_stream.sample_elapsed_ms value=245.000/PERF_RESOURCE read_stream.sample_elapsed_ms value=0.000/' \
    "${log_file}" > "${zero_denominator_log}"
  local zero_denominator_summary="${scenario_dir}/zero-denominator-summary.md"
  RESOURCE_PERFORMANCE_LOG="${zero_denominator_log}" \
  GITHUB_STEP_SUMMARY="${zero_denominator_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${zero_denominator_summary}" '| `read_stream` | n/a | n/a | n/a |'
  local zero_denominator_jsonl="${scenario_dir}/zero-denominator.jsonl"
  "${SCRIPT_DIR}/parse-resource-performance" "${zero_denominator_log}" >"${zero_denominator_jsonl}"
  expect_contains "${zero_denominator_jsonl}" \
    '"type":"derived","baseline_run":1,"operation":"read_stream","user_cpu_ms_per_mib":null,"system_cpu_ms_per_mib":null,"cpu_utilization":null'

  local missing_full_log="${scenario_dir}/missing-full-synthetic.log"
  grep -v 'stage=full_synthetic ' "${log_file}" > "${missing_full_log}"
  local missing_full_jsonl="${scenario_dir}/missing-full-synthetic.jsonl"
  "${SCRIPT_DIR}/parse-resource-performance" "${missing_full_log}" >"${missing_full_jsonl}"
  if grep -q '"type":"derived_stage"' "${missing_full_jsonl}"; then
    echo 'parser unexpectedly emitted a stage share without full_synthetic' >&2
    return 1
  fi
  local missing_full_summary="${scenario_dir}/missing-full-synthetic-summary.md"
  RESOURCE_PERFORMANCE_LOG="${missing_full_log}" \
  GITHUB_STEP_SUMMARY="${missing_full_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  expect_contains "${missing_full_summary}" \
    '| signing only | 640.369 ms | 12.493 MiB/s | n/a | AES-CMAC cost |'

  local boundary_log="${scenario_dir}/boundary.log"
  sed \
    -e 's/PERF_RESOURCE read_stream.throughput_mib_s value=737.364/PERF_RESOURCE read_stream.throughput_mib_s value=400.000/' \
    -e 's/PERF_RESOURCE read_stream.sample_elapsed_ms value=245.000/PERF_RESOURCE read_stream.sample_elapsed_ms value=200.000/' \
    -e 's/PERF_RESOURCE write_stream.max_rss_kb value=286048/PERF_RESOURCE write_stream.max_rss_kb value=524288/' \
    "${log_file}" > "${boundary_log}"
  local boundary_summary="${scenario_dir}/boundary-summary.md"
  RESOURCE_PERFORMANCE_LOG="${boundary_log}" \
  GITHUB_STEP_SUMMARY="${boundary_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  # Existing comparison operators are part of the contract: throughput/RSS fail at equality, duration passes at equality.
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${boundary_summary}" \
    '| `read_stream` | Throughput | ❌ Fail | 400.000 MiB/s | Higher ↑ | > 400 MiB/s | Median |' \
    '| `read_stream` | Measured duration | ✅ Pass | 200.000 ms | Stable window | ≥ 200 ms | Median |' \
    '| `write_stream` | Process max RSS | ❌ Fail | 512.0 MiB | Lower ↓ | < 512 MiB | Peak |'

  local no_cache_log="${scenario_dir}/no-cache.log"
  grep -v '^PERF_BUILD_CACHE ' "${log_file}" > "${no_cache_log}"
  local no_cache_summary="${scenario_dir}/no-cache-summary.md"
  RESOURCE_PERFORMANCE_LOG="${no_cache_log}" \
  GITHUB_STEP_SUMMARY="${no_cache_summary}" \
  GITHUB_SHA="0123456789abcdef" \
  SWIFT_IMAGE="swift:test" \
  RUNNER_OS="Linux" \
  RUNNER_ARCH="X64" \
  RESOURCE_BASELINE_RUNS=2 \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  expect_contains "${no_cache_summary}" \
    '- Raw samples: **read_stream=10, write_stream=10**' \
    '- Build cache exact hit: **unknown**'
}

test_artifact_and_summary_parse_failure() {
  local scenario_dir
  scenario_dir="$(new_scenario_dir)"
  local log_file="${scenario_dir}/resource.log"
  write_canonical_log "${log_file}"
  local parse_failure_log="${scenario_dir}/parse-failure.log"
  sed '/^PERF_FORMAT /d' "${log_file}" > "${parse_failure_log}"
  local parse_failure_jsonl="${scenario_dir}/parse-failure.jsonl"
  if RESOURCE_PERFORMANCE_LOG="${parse_failure_log}" \
    RESOURCE_PERFORMANCE_JSONL="${parse_failure_jsonl}" \
    "${SCRIPT_DIR}/write-resource-performance-artifact"; then
    echo 'artifact unexpectedly accepted a malformed log' >&2
    return 1
  fi
  expect_contains "${parse_failure_jsonl}" '"type":"metadata"' '"type":"parse_failure"'
  local parse_failure_summary="${scenario_dir}/parse-failure-summary.md"
  if RESOURCE_PERFORMANCE_LOG="${parse_failure_log}" \
    GITHUB_STEP_SUMMARY="${parse_failure_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"; then
    echo 'summary unexpectedly accepted a malformed log' >&2
    return 1
  fi
  expect_contains "${parse_failure_summary}" '❌ Parse failed' 'Parse failed:'
}

