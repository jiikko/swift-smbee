test_run_resource_performance_invalid_cache_path() {
  local scenario_dir scenario_repo invalid_cache
  scenario_dir="$(new_scenario_dir)"
  scenario_repo="${scenario_dir}/scenario-repo"
  mkdir -p "${scenario_repo}"
  write_docker_stub "${scenario_dir}"

  for invalid_cache in \
    relative/swiftpm-cache \
    "${scenario_dir}/cache:with-colon"; do
    rm -f "${scenario_dir}/docker-stub-called"
    if env -u RESOURCE_PERFORMANCE_LOG \
      PATH="${scenario_dir}:${PATH}" \
      SWIFT_IMAGE=swift:test \
      DOCKER_STUB_MARKER="${scenario_dir}/docker-stub-called" \
      RESOURCE_REPO_ROOT="${scenario_repo}" \
      RESOURCE_SWIFTPM_CACHE_DIR="${invalid_cache}" \
      RESOURCE_BASELINE_RUNS=1 \
      RESOURCE_SKIP_BUILD=true \
      RESOURCE_APPEND_LOG=false \
      RESOURCE_BASELINE_RUN_OFFSET=0 \
      RESOURCE_BASELINE_RUN_TOTAL=1 \
        "${SCRIPT_DIR}/run-resource-performance" \
        >"${scenario_dir}/invalid.out" 2>"${scenario_dir}/invalid.err"; then
      echo "run-resource-performance unexpectedly accepted ${invalid_cache}" >&2
      return 1
    fi
    expect_contains "${scenario_dir}/invalid.err" \
      "RESOURCE_SWIFTPM_CACHE_DIR must be an absolute path without ':'"
    test ! -e "${scenario_dir}/docker-stub-called"
  done
}

test_run_resource_performance_rejects_download_log() {
  local scenario_dir scenario_repo docker_log cache_dir resource_log
  scenario_dir="$(new_scenario_dir)"
  scenario_repo="${scenario_dir}/scenario-repo"
  docker_log="${scenario_dir}/docker-call"
  cache_dir="${scenario_repo}/.build/swiftpm-cache"
  resource_log="${scenario_repo}/.build/resource-performance.log"
  mkdir -p "${scenario_repo}"
  write_docker_stub "${scenario_dir}"

  if env -u RESOURCE_PERFORMANCE_LOG -u RESOURCE_SWIFTPM_CACHE_DIR \
    PATH="${scenario_dir}:${PATH}" \
    SWIFT_IMAGE=swift:test \
    DOCKER_STUB_MARKER="${scenario_dir}/docker-stub-called" \
    DOCKER_STUB_LOG="${docker_log}" \
    DOCKER_STUB_DOWNLOAD_LOG="${resource_log}" \
    RESOURCE_REPO_ROOT="${scenario_repo}" \
    RESOURCE_BASELINE_RUNS=1 \
    RESOURCE_SKIP_BUILD=true \
    RESOURCE_APPEND_LOG=false \
    RESOURCE_BASELINE_RUN_OFFSET=0 \
    RESOURCE_BASELINE_RUN_TOTAL=1 \
      "${SCRIPT_DIR}/run-resource-performance" \
      >"${scenario_dir}/run.out" 2>"${scenario_dir}/run.err"; then
    echo 'run-resource-performance unexpectedly accepted a binary artifact download in the log' >&2
    return 1
  fi

  test -e "${scenario_dir}/docker-stub-called"
  test -f "${resource_log}"
  expect_resource_performance_docker_argv "${docker_log}.1" "${scenario_repo}" "${cache_dir}"
  expect_contains "${resource_log}" 'Downloading binary artifact'
  expect_contains "${scenario_dir}/run.err" \
    'resource-performance measurement downloaded a binary artifact; SwiftPM cache invariant failed'
}

