    "${log_file}" > "${zero_denominator_log}"
  local zero_denominator_summary="${scenario_dir}/zero-denominator-summary.md"
  RESOURCE_PERFORMANCE_LOG="${zero_denominator_log}" \
  GITHUB_STEP_SUMMARY="${zero_denominator_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${zero_denominator_summary}" '| `read_stream` | n/a | n/a | n/a |'
  local zero_denominator_jsonl="${scenario_dir}/zero-denominator.jsonl"
  "${SCRIPT_DIR}/parse-resource-performance" "${zero_denominator_log}" >"${zero_denominator_jsonl}"
  expect_contains "${zero_denominator_jsonl}" \
    '"type":"derived","baseline_run":1,"operation":"read_stream","user_cpu_ms_per_mib":null,"system_cpu_ms_per_mib":null,"cpu_utilization":null'

  local missing_full_log="${scenario_dir}/missing-full-synthetic.log"
  grep -v 'stage=full_synthetic ' "${log_file}" > "${missing_full_log}"
  local missing_full_jsonl="${scenario_dir}/missing-full-synthetic.jsonl"
  "${SCRIPT_DIR}/parse-resource-performance" "${missing_full_log}" >"${missing_full_jsonl}"
  if grep -q '"type":"derived_stage"' "${missing_full_jsonl}"; then
    echo 'parser unexpectedly emitted a stage share without full_synthetic' >&2
    return 1
  fi
  local missing_full_summary="${scenario_dir}/missing-full-synthetic-summary.md"
  RESOURCE_PERFORMANCE_LOG="${missing_full_log}" \
  GITHUB_STEP_SUMMARY="${missing_full_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  expect_contains "${missing_full_summary}" \
    '| signing only | 640.369 ms | 12.493 MiB/s | n/a | MAD 0.000 ms; 640.369–640.369 ms | 2 | AES-CMAC cost |'

  local boundary_log="${scenario_dir}/boundary.log"
  sed \
    -e 's/PERF_RESOURCE read_stream.throughput_mib_s value=737.364/PERF_RESOURCE read_stream.throughput_mib_s value=400.000/' \
    -e 's/PERF_RESOURCE read_stream.sample_elapsed_ms value=245.000/PERF_RESOURCE read_stream.sample_elapsed_ms value=200.000/' \
    -e 's/PERF_RESOURCE write_stream.max_rss_kb value=286048/PERF_RESOURCE write_stream.max_rss_kb value=524288/' \
    "${log_file}" > "${boundary_log}"
  local boundary_summary="${scenario_dir}/boundary-summary.md"
  RESOURCE_PERFORMANCE_LOG="${boundary_log}" \
  GITHUB_STEP_SUMMARY="${boundary_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  # Existing comparison operators are part of the contract: throughput/RSS fail at equality, duration passes at equality.
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${boundary_summary}" \
    '| `read_stream` | Throughput | ❌ Fail | 400.000 MiB/s | 1.00× / +0.0% | Higher ↑ | > 400 MiB/s | Median |' \
    '| `read_stream` | Measured duration | ✅ Pass | 200.000 ms | — | Stable window | ≥ 100 ms | Median |' \
    'XCTest process peak RSS: **512.0 MiB** · ❌ Fail (`< 512 MiB` guardrail).'

  local no_cache_log="${scenario_dir}/no-cache.log"
  grep -v '^PERF_BUILD_CACHE ' "${log_file}" > "${no_cache_log}"
  local no_cache_summary="${scenario_dir}/no-cache-summary.md"
  RESOURCE_PERFORMANCE_LOG="${no_cache_log}" \
  GITHUB_STEP_SUMMARY="${no_cache_summary}" \
  GITHUB_SHA="0123456789abcdef" \
  SWIFT_IMAGE="swift:test" \
  RUNNER_OS="Linux" \
  RUNNER_ARCH="X64" \
  RESOURCE_BASELINE_RUNS=2 \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  expect_contains "${no_cache_summary}" \
    '- Raw samples: **read_stream=10, write_stream=10**' \
    'Cache exact hit: **unknown**'
}

test_artifact_and_summary_parse_failure() {
  local scenario_dir
  scenario_dir="$(new_scenario_dir)"
  local log_file="${scenario_dir}/resource.log"
  write_canonical_log "${log_file}"
  local parse_failure_log="${scenario_dir}/parse-failure.log"
  sed '/^PERF_FORMAT /d' "${log_file}" > "${parse_failure_log}"
  local parse_failure_jsonl="${scenario_dir}/parse-failure.jsonl"
  if RESOURCE_PERFORMANCE_LOG="${parse_failure_log}" \
    RESOURCE_PERFORMANCE_JSONL="${parse_failure_jsonl}" \
    "${SCRIPT_DIR}/write-resource-performance-artifact"; then
    echo 'artifact unexpectedly accepted a malformed log' >&2
    return 1
  fi
  expect_contains "${parse_failure_jsonl}" '"type":"metadata"' '"type":"parse_failure"'
  local parse_failure_summary="${scenario_dir}/parse-failure-summary.md"
  if RESOURCE_PERFORMANCE_LOG="${parse_failure_log}" \
    GITHUB_STEP_SUMMARY="${parse_failure_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"; then
    echo 'summary unexpectedly accepted a malformed log' >&2
    return 1
  fi
  expect_contains "${parse_failure_summary}" '❌ Parse failed' 'Parse failed:'
}

test_missing_log_metadata() {
  local scenario_dir
  scenario_dir="$(new_scenario_dir)"
  local missing_log="${scenario_dir}/missing.log"
  local missing_jsonl="${scenario_dir}/missing.jsonl"
  # The hosted runner exports GITHUB_RUN_ID/ATTEMPT for real; unset them so the
  # "unknown" expectations below stay environment-independent.
  env -u GITHUB_RUN_ID -u GITHUB_RUN_ATTEMPT \
    RESOURCE_PERFORMANCE_LOG="${missing_log}" \
    RESOURCE_PERFORMANCE_JSONL="${missing_jsonl}" \
    "${SCRIPT_DIR}/write-resource-performance-artifact"
  expect_contains "${missing_jsonl}" '"type":"metadata"'
  local missing_summary="${scenario_dir}/missing-summary.md"
  env -u GITHUB_RUN_ID -u GITHUB_RUN_ATTEMPT \
    RESOURCE_PERFORMANCE_LOG="${missing_log}" \
    GITHUB_STEP_SUMMARY="${missing_summary}" \
    "${SCRIPT_DIR}/publish-resource-performance-summary"
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${missing_summary}" \
    '⚠️ Unavailable' \
    '- Image digest: `unknown`' \
    '- GITHUB_RUN_ID: `unknown`' \
    '- Swift version full: `unknown`' \
    '- Kernel: `unknown`' \
    '- CPU model: `unknown`' \
    '- CPU count: `unknown`'
}

