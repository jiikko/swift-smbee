#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

for script in \
  "${SCRIPT_DIR}/swift-image" \
  "${SCRIPT_DIR}/run-performance-regression" \
  "${SCRIPT_DIR}/run-resource-performance" \
  "${SCRIPT_DIR}/parse-resource-performance" \
  "${SCRIPT_DIR}/publish-resource-performance-summary" \
  "${SCRIPT_DIR}/write-resource-performance-artifact"; do
  case "${script}" in
    *parse-resource-performance) ;;
    *) bash -n "${script}" ;;
  esac
done
PYTHONDONTWRITEBYTECODE=1 python3 - "${SCRIPT_DIR}/parse-resource-performance" <<'PY'
import ast
import pathlib
import sys

ast.parse(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
PY

expected_image="swift:$(tr -d '[:space:]' < "${REPO_ROOT}/.swift-version")"
actual_image="$("${SCRIPT_DIR}/swift-image")"
if [ "${actual_image}" != "${expected_image}" ]; then
  echo "swift-image mismatch: expected ${expected_image}, got ${actual_image}" >&2
  exit 1
fi

temporary="$(mktemp -d)"
trap 'rm -rf "${temporary}"' EXIT
log_file="${temporary}/resource.log"
summary_file="${temporary}/summary.md"

cat > "${log_file}" <<'EOF'
PERF_BUILD_CACHE exact_hit=false
EOF
for baseline_run in 1 2; do
  cat >> "${log_file}" <<EOF
PERF_BASELINE_RUN run=${baseline_run} total=2
$(if [ "${baseline_run}" -eq 1 ]; then echo 'PERF_METRIC deterministic_command_count actual=12 expected=12'; fi)
PERF_FORMAT version=1
EOF
  for sample_run in 1 2 3 4 5; do
    cat >> "${log_file}" <<EOF
PERF_RESOURCE_SAMPLE operation=read_stream run=${sample_run} elapsed_ms=245.000 throughput_mib_s=653.061 user_cpu_ms=200.000 system_cpu_ms=4.000 max_rss_kb=286048 total_size_mib=160 iterations=20
EOF
  done
  cat >> "${log_file}" <<'EOF'
PERF_RESOURCE read_stream.throughput_mib_s value=737.364 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release
PERF_RESOURCE read_stream.user_cpu_ms value=200.000 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release
PERF_RESOURCE read_stream.system_cpu_ms value=4.000 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release
PERF_RESOURCE read_stream.sample_elapsed_ms value=245.000 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release
PERF_RESOURCE read_stream.max_rss_kb value=286048 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release
PERF_RUN_COMPLETE operation=read_stream
PERF_FORMAT version=1
EOF
  for sample_run in 1 2 3 4 5; do
    cat >> "${log_file}" <<EOF
PERF_RESOURCE_SAMPLE operation=write_stream run=${sample_run} elapsed_ms=1096.000 throughput_mib_s=7.298 user_cpu_ms=1102.000 system_cpu_ms=0.000 max_rss_kb=286048 total_size_mib=8 iterations=1
EOF
  done
  cat >> "${log_file}" <<'EOF'
PERF_RESOURCE write_stream.throughput_mib_s value=7.298 size_mib=8 runs=5 iterations=1 throughput_floor_mib_s=5 config=release
PERF_RESOURCE write_stream.user_cpu_ms value=1102.000 size_mib=8 runs=5 iterations=1 throughput_floor_mib_s=5 config=release
PERF_RESOURCE write_stream.system_cpu_ms value=0.000 size_mib=8 runs=5 iterations=1 throughput_floor_mib_s=5 config=release
PERF_RESOURCE write_stream.sample_elapsed_ms value=1096.000 size_mib=8 runs=5 iterations=1 throughput_floor_mib_s=5 config=release
PERF_RESOURCE write_stream.max_rss_kb value=286048 size_mib=8 runs=5 iterations=1 throughput_floor_mib_s=5 config=release
PERF_RUN_COMPLETE operation=write_stream
EOF
  if [ "${baseline_run}" -eq 1 ]; then
    cat >> "${log_file}" <<'EOF'
PERF_WRITE_PROFILE stage=signing_only median_ms=640.369 throughput_mib_s=12.493 size_mib=8 runs=5 chunks=128
EOF
  fi
  printf '\tMaximum resident set size (kbytes): 682080\n' >> "${log_file}"
done

RESOURCE_PERFORMANCE_LOG="${log_file}" \
GITHUB_STEP_SUMMARY="${summary_file}" \
  "${SCRIPT_DIR}/publish-resource-performance-summary"

# Literal Markdown backticks are intentional; expanding them would execute commands.
# shellcheck disable=SC2016
grep -F '| `read_stream` | Throughput | ✅ Pass | 737.364 MiB/s | Higher ↑ | > 400 MiB/s | Median | 160 MiB × 5 runs × 20 iterations |' "${summary_file}"
# shellcheck disable=SC2016
grep -F '| `read_stream` | User CPU | ℹ️ Observe | 200.000 ms | Lower ↓ | Observation only | Median | 160 MiB × 5 runs × 20 iterations |' "${summary_file}"
# shellcheck disable=SC2016
grep -F '| `read_stream` | Measured duration | ✅ Pass | 245.000 ms | Stable window | ≥ 200 ms | Median | 160 MiB × 5 runs × 20 iterations |' "${summary_file}"
# shellcheck disable=SC2016
grep -F '| `write_stream` | Process max RSS | ✅ Pass | 279.3 MiB | Lower ↓ | < 512 MiB | Peak | 8 MiB × 5 runs × 1 iterations |' "${summary_file}"
grep -F 'Compiler + XCTest maximum RSS: **666.0 MiB** (682080 KiB).' "${summary_file}"
grep -F '| signing only | 640.369 ms | 12.493 MiB/s | AES-CMAC cost |' "${summary_file}"

jsonl_file="${temporary}/resource.jsonl"
RESOURCE_PERFORMANCE_LOG="${log_file}" \
RESOURCE_PERFORMANCE_JSONL="${jsonl_file}" \
RESOURCE_BASELINE_RUNS=2 \
GITHUB_SHA="0123456789abcdef" \
RUNNER_OS="Linux" \
RUNNER_ARCH="X64" \
  "${SCRIPT_DIR}/write-resource-performance-artifact"
grep -F '"type":"metadata","commit_sha":"0123456789abcdef"' "${jsonl_file}"
grep -F '"baseline_runs":2' "${jsonl_file}"
grep -F '"type":"sample","baseline_run":1,"operation":"read_stream","run":1,"elapsed_ms":245.000' "${jsonl_file}"
grep -F '"type":"summary","baseline_run":1,"name":"read_stream.throughput_mib_s","value":737.364' "${jsonl_file}"
grep -F '"type":"process","baseline_run":1,"metric":"max_rss_kb","value":682080' "${jsonl_file}"
grep -F '"type":"write_profile","baseline_run":1,"stage":"signing_only","median_ms":640.369' "${jsonl_file}"
grep -F '"type":"sample","baseline_run":2,"operation":"read_stream","run":1,"elapsed_ms":245.000' "${jsonl_file}"
grep -F '"type":"sample","baseline_run":2,"operation":"write_stream","run":1,"elapsed_ms":1096.000' "${jsonl_file}"
for operation in read_stream write_stream; do
  for metric in throughput_mib_s user_cpu_ms system_cpu_ms sample_elapsed_ms max_rss_kb; do
    grep -F "\"type\":\"summary\",\"baseline_run\":2,\"name\":\"${operation}.${metric}\"" "${jsonl_file}"
  done
done
grep -F '"type":"process","baseline_run":2,"metric":"max_rss_kb","value":682080' "${jsonl_file}"

baseline_summary="${temporary}/baseline.md"
"${SCRIPT_DIR}/summarize-resource-baseline" "${jsonl_file}" > "${baseline_summary}"
grep -F '# SMBee resource performance baseline' "${baseline_summary}"
# Literal Markdown backticks are intentional.
# shellcheck disable=SC2016
grep -F '| `read_stream.throughput_mib_s` | 2 | 737.364 | 737.364 | 737.364 | 0.000 | 0.0000 | 737.364 | 737.364 |' "${baseline_summary}"
grep -F -- '- first invocation (includes Release build): 666.1 MiB' "${baseline_summary}"
grep -F -- '- baseline invocations: 2' "${baseline_summary}"

expect_parser_failure() {
  local name="$1"
  local fixture="$2"
  if "${SCRIPT_DIR}/parse-resource-performance" "${fixture}" >"${temporary}/${name}.out" 2>"${temporary}/${name}.err"; then
    echo "parser unexpectedly accepted ${name}" >&2
    exit 1
  fi
  test -s "${temporary}/${name}.err"
}

sed '/^PERF_RESOURCE_SAMPLE operation=read_stream run=1 /s/ iterations=20//' "${log_file}" > "${temporary}/missing-field.log"
expect_parser_failure missing-field "${temporary}/missing-field.log"
sed 's/elapsed_ms=245.000/elapsed_ms=not-a-number/' "${log_file}" > "${temporary}/invalid-number.log"
expect_parser_failure invalid-number "${temporary}/invalid-number.log"
sed 's/PERF_METRIC deterministic_command_count actual=12 expected=12/PERF_METRIC deterministic_command_count actual=12/' "${log_file}" > "${temporary}/malformed-metric.log"
expect_parser_failure malformed-metric "${temporary}/malformed-metric.log"
sed 's/PERF_METRIC deterministic_command_count actual=12 expected=12/PERF_METRIC deterministic_command_count actual=-1.25e+2 expected=2.5E2/' "${log_file}" > "${temporary}/numeric-metric.log"
"${SCRIPT_DIR}/parse-resource-performance" "${temporary}/numeric-metric.log" > /dev/null
cp "${log_file}" "${temporary}/malformed.log"
echo 'PERF_RESOURCE_SAMPLE malformed' >> "${temporary}/malformed.log"
expect_parser_failure malformed "${temporary}/malformed.log"
grep -v '^PERF_FORMAT ' "${log_file}" > "${temporary}/missing-format.log"
expect_parser_failure missing-format "${temporary}/missing-format.log"
sed 's/PERF_FORMAT version=1/PERF_FORMAT version=2/' "${log_file}" > "${temporary}/wrong-format.log"
expect_parser_failure wrong-format "${temporary}/wrong-format.log"
sed '/^PERF_RUN_COMPLETE operation=read_stream/d' "${log_file}" > "${temporary}/missing-completion.log"
expect_parser_failure missing-completion "${temporary}/missing-completion.log"
awk '/PERF_RESOURCE read_stream.throughput_mib_s value=737.364/ { print; print "PERF_RESOURCE read_stream.throughput_mib_s value=737.364 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release"; next } { print }' "${log_file}" > "${temporary}/duplicate-metric.log"
expect_parser_failure duplicate-metric "${temporary}/duplicate-metric.log"
awk '/PERF_RUN_COMPLETE operation=read_stream/ { print; print "PERF_RESOURCE_SAMPLE operation=read_stream run=1 elapsed_ms=245.000 throughput_mib_s=653.061 user_cpu_ms=200.000 system_cpu_ms=4.000 max_rss_kb=286048 total_size_mib=160 iterations=20"; next } { print }' "${log_file}" > "${temporary}/resource-after-completion.log"
expect_parser_failure resource-after-completion "${temporary}/resource-after-completion.log"
awk '/PERF_RUN_COMPLETE operation=read_stream/ { print; print "PERF_RESOURCE read_stream.throughput_mib_s value=737.364 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release"; next } { print }' "${log_file}" > "${temporary}/summary-after-completion.log"
expect_parser_failure summary-after-completion "${temporary}/summary-after-completion.log"
# PERF_FORMAT after the previous operation's completion is legitimate (each
# resource test prints one), so the failure case is FORMAT after ALL
# operations of the baseline run completed.
awk '/PERF_RUN_COMPLETE operation=write_stream/ { print; print "PERF_FORMAT version=1"; next } { print }' "${log_file}" > "${temporary}/format-after-completion.log"
expect_parser_failure format-after-completion "${temporary}/format-after-completion.log"
cp "${log_file}" "${temporary}/duplicate-baseline.log"
echo 'PERF_BASELINE_RUN run=1 total=2' >> "${temporary}/duplicate-baseline.log"
expect_parser_failure duplicate-baseline "${temporary}/duplicate-baseline.log"
sed 's/PERF_BASELINE_RUN run=2 total=2/PERF_BASELINE_RUN run=3 total=2/' "${log_file}" > "${temporary}/noncontinuous-baseline.log"
expect_parser_failure noncontinuous-baseline "${temporary}/noncontinuous-baseline.log"
grep -v 'write_stream' "${log_file}" > "${temporary}/missing-operation.log"
expect_parser_failure missing-operation "${temporary}/missing-operation.log"

boundary_log="${temporary}/boundary.log"
sed \
  -e 's/PERF_RESOURCE read_stream.throughput_mib_s value=737.364/PERF_RESOURCE read_stream.throughput_mib_s value=400.000/' \
  -e 's/PERF_RESOURCE read_stream.sample_elapsed_ms value=245.000/PERF_RESOURCE read_stream.sample_elapsed_ms value=200.000/' \
  -e 's/PERF_RESOURCE write_stream.max_rss_kb value=286048/PERF_RESOURCE write_stream.max_rss_kb value=524288/' \
  "${log_file}" > "${boundary_log}"
boundary_summary="${temporary}/boundary-summary.md"
RESOURCE_PERFORMANCE_LOG="${boundary_log}" \
GITHUB_STEP_SUMMARY="${boundary_summary}" \
  "${SCRIPT_DIR}/publish-resource-performance-summary"
# Existing comparison operators are part of the contract: throughput/RSS fail at equality, duration passes at equality.
# shellcheck disable=SC2016
grep -F '| `read_stream` | Throughput | ❌ Fail | 400.000 MiB/s | Higher ↑ | > 400 MiB/s | Median |' "${boundary_summary}"
# shellcheck disable=SC2016
grep -F '| `read_stream` | Measured duration | ✅ Pass | 200.000 ms | Stable window | ≥ 200 ms | Median |' "${boundary_summary}"
# shellcheck disable=SC2016
grep -F '| `write_stream` | Process max RSS | ❌ Fail | 512.0 MiB | Lower ↓ | < 512 MiB | Peak |' "${boundary_summary}"

parse_failure_log="${temporary}/parse-failure.log"
sed '/^PERF_FORMAT /d' "${log_file}" > "${parse_failure_log}"
if RESOURCE_PERFORMANCE_LOG="${parse_failure_log}" \
  RESOURCE_PERFORMANCE_JSONL="${temporary}/parse-failure.jsonl" \
  "${SCRIPT_DIR}/write-resource-performance-artifact"; then
  echo 'artifact unexpectedly accepted a malformed log' >&2
  exit 1
fi
grep -F '"type":"metadata"' "${temporary}/parse-failure.jsonl"
grep -F '"type":"parse_failure"' "${temporary}/parse-failure.jsonl"
parse_failure_summary="${temporary}/parse-failure-summary.md"
if RESOURCE_PERFORMANCE_LOG="${parse_failure_log}" \
  GITHUB_STEP_SUMMARY="${parse_failure_summary}" \
  "${SCRIPT_DIR}/publish-resource-performance-summary"; then
  echo 'summary unexpectedly accepted a malformed log' >&2
  exit 1
fi
grep -F '❌ Parse failed' "${parse_failure_summary}"
grep -F 'Parse failed:' "${parse_failure_summary}"

missing_log="${temporary}/missing.log"
missing_jsonl="${temporary}/missing.jsonl"
RESOURCE_PERFORMANCE_LOG="${missing_log}" \
RESOURCE_PERFORMANCE_JSONL="${missing_jsonl}" \
  "${SCRIPT_DIR}/write-resource-performance-artifact"
grep -F '"type":"metadata"' "${missing_jsonl}"
missing_summary="${temporary}/missing-summary.md"
RESOURCE_PERFORMANCE_LOG="${missing_log}" \
GITHUB_STEP_SUMMARY="${missing_summary}" \
  "${SCRIPT_DIR}/publish-resource-performance-summary"
grep -F '⚠️ Unavailable' "${missing_summary}"

echo 'Performance CI script tests passed.'
