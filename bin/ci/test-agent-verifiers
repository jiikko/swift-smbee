#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
temporary="$(mktemp -d)"
trap 'rm -rf "${temporary}"' EXIT

commit_sha="$(git -C "${REPO_ROOT}" rev-parse HEAD)"

cat >"${temporary}/gh" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail

if [ "${GH_STUB_MODE}" = retry ]; then
  count=0
  if [ -f "${GH_STUB_COUNT}" ]; then
    count="$(cat "${GH_STUB_COUNT}")"
  fi
  count=$((count + 1))
  printf '%s\n' "${count}" >"${GH_STUB_COUNT}"
  if [ "${count}" -lt 3 ]; then
    echo "temporary GitHub failure" >&2
    exit 1
  fi
  echo "retry recovered"
  exit 0
fi

if [ "${1:-}" = run ] && [ "${2:-}" = list ]; then
  case "${GH_STUB_MODE}" in
    success)
      cat <<EOF
[
  {"databaseId":101,"name":"Test","status":"completed","conclusion":"success","url":"https://example.test/test","headSha":"${GH_STUB_SHA}"},
  {"databaseId":102,"name":"E2E","status":"completed","conclusion":"success","url":"https://example.test/e2e","headSha":"${GH_STUB_SHA}"},
  {"databaseId":103,"name":"Performance","status":"completed","conclusion":"success","url":"https://example.test/performance","headSha":"${GH_STUB_SHA}"}
]
EOF
      ;;
    failure)
      cat <<EOF
[
  {"databaseId":201,"name":"Test","status":"completed","conclusion":"success","url":"https://example.test/test","headSha":"${GH_STUB_SHA}"},
  {"databaseId":202,"name":"E2E","status":"completed","conclusion":"failure","url":"https://example.test/e2e","headSha":"${GH_STUB_SHA}"},
  {"databaseId":203,"name":"Performance","status":"completed","conclusion":"success","url":"https://example.test/performance","headSha":"${GH_STUB_SHA}"}
]
EOF
      ;;
    progress)
      cat <<EOF
[
  {"databaseId":301,"name":"Test","status":"in_progress","conclusion":"","url":"https://example.test/test","headSha":"${GH_STUB_SHA}"},
  {"databaseId":302,"name":"E2E","status":"queued","conclusion":"","url":"https://example.test/e2e","headSha":"${GH_STUB_SHA}"},
  {"databaseId":303,"name":"Performance","status":"in_progress","conclusion":"","url":"https://example.test/performance","headSha":"${GH_STUB_SHA}"}
]
EOF
      ;;
  esac
  exit 0
fi

if [ "${1:-}" = run ] && [ "${2:-}" = view ]; then
  if printf '%s\n' "$@" | grep -q -- --log-failed; then
    echo "/work/Test.swift:42: error: XCTAssertTrue failed"
  else
    echo "  failure: failing E2E job (https://example.test/job/202)"
  fi
  exit 0
fi

echo "unexpected gh invocation: $*" >&2
exit 2
STUB
chmod +x "${temporary}/gh"

cat >"${temporary}/performance-verifier" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$1" >"${PERFORMANCE_STUB_MARKER}"
echo "performance artifacts verified"
STUB
chmod +x "${temporary}/performance-verifier"

retry_output="$(
  PATH="${temporary}:${PATH}" \
  GH_STUB_MODE=retry \
  GH_STUB_COUNT="${temporary}/retry-count" \
  GH_RETRY_ATTEMPTS=3 \
  GH_RETRY_INITIAL_DELAY=0 \
  GH_RETRY_MAX_DELAY=0 \
    "${SCRIPT_DIR}/gh-retry" gh run list 2>"${temporary}/retry.err"
)"
test "${retry_output}" = "retry recovered"
test "$(<"${temporary}/retry-count")" -eq 3
grep -Fq 'GitHub CLI attempt 1/3 failed' "${temporary}/retry.err"

PATH="${temporary}:${PATH}" \
GH_STUB_MODE=success \
GH_STUB_SHA="${commit_sha}" \
GH_RETRY_ATTEMPTS=1 \
PERFORMANCE_STUB_MARKER="${temporary}/performance-marker" \
AGENT_PUSH_VERIFY_PERFORMANCE_COMMAND="${temporary}/performance-verifier" \
  "${SCRIPT_DIR}/verify-agent-push" "${commit_sha}" \
  >"${temporary}/success.out" 2>"${temporary}/success.err"
grep -Fq 'Test        completed    success' "${temporary}/success.out"
grep -Fq 'Verified push CI for commit' "${temporary}/success.out"
test "$(<"${temporary}/performance-marker")" = "${commit_sha}"

if PATH="${temporary}:${PATH}" \
  GH_STUB_MODE=failure \
  GH_STUB_SHA="${commit_sha}" \
  GH_RETRY_ATTEMPTS=1 \
  PERFORMANCE_STUB_MARKER="${temporary}/unexpected-performance-marker" \
  AGENT_PUSH_VERIFY_PERFORMANCE_COMMAND="${temporary}/performance-verifier" \
    "${SCRIPT_DIR}/verify-agent-push" "${commit_sha}" \
    >"${temporary}/failure.out" 2>"${temporary}/failure.err"; then
  echo "verify-agent-push unexpectedly accepted a failed E2E workflow" >&2
  exit 1
fi
grep -Fq 'E2E workflow failed' "${temporary}/failure.err"
grep -Fq 'failing E2E job' "${temporary}/failure.err"
grep -Fq 'XCTAssertTrue failed' "${temporary}/failure.err"
test ! -e "${temporary}/unexpected-performance-marker"

if PATH="${temporary}:${PATH}" \
  GH_STUB_MODE=progress \
  GH_STUB_SHA="${commit_sha}" \
  GH_RETRY_ATTEMPTS=1 \
  AGENT_PUSH_VERIFY_TIMEOUT_SECONDS=1 \
  AGENT_PUSH_VERIFY_POLL_SECONDS=1 \
  PERFORMANCE_STUB_MARKER="${temporary}/timeout-performance-marker" \
  AGENT_PUSH_VERIFY_PERFORMANCE_COMMAND="${temporary}/performance-verifier" \
    "${SCRIPT_DIR}/verify-agent-push" "${commit_sha}" \
    >"${temporary}/timeout.out" 2>"${temporary}/timeout.err"; then
  echo "verify-agent-push unexpectedly accepted unfinished workflows" >&2
  exit 1
fi
grep -Fq 'Test=in_progress E2E=queued Performance=in_progress' "${temporary}/timeout.out"
grep -Fq 'Timed out waiting for all required workflows' "${temporary}/timeout.err"
test ! -e "${temporary}/timeout-performance-marker"

echo "Agent verifier tests passed."
