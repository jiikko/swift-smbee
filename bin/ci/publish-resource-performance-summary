#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
LOG_FILE="${RESOURCE_PERFORMANCE_LOG:-${REPO_ROOT}/.build/resource-performance.log}"
SUMMARY_FILE="${GITHUB_STEP_SUMMARY:?GITHUB_STEP_SUMMARY is required}"

temporary="$(mktemp -d)"
trap 'rm -rf "${temporary}"' EXIT
metadata_file="${temporary}/metadata.jsonl"
validated_jsonl="${temporary}/resource-performance.jsonl"

parse_status=0
if [ -f "${LOG_FILE}" ]; then
  "${SCRIPT_DIR}/parse-resource-performance" "${LOG_FILE}" >"${validated_jsonl}" || parse_status=$?
fi
if [ -f "${validated_jsonl}" ] && [ "${parse_status}" -eq 0 ]; then
  RESOURCE_PERFORMANCE_ENV_JSONL="${validated_jsonl}" \
    "${SCRIPT_DIR}/resource-performance-metadata" >"${metadata_file}"
else
  "${SCRIPT_DIR}/resource-performance-metadata" >"${metadata_file}"
fi

{
  echo '## SMBee resource performance'
  echo
  echo '### Run metadata'
  echo
  if [ -f "${validated_jsonl}" ] && [ "${parse_status}" -eq 0 ]; then
    python3 - "${metadata_file}" "${validated_jsonl}" <<'PY'
import json
import sys

metadata = json.loads(next(line for line in open(sys.argv[1], encoding="utf-8") if line.strip()))
rows = [json.loads(line) for line in open(sys.argv[2], encoding="utf-8") if line.strip()]
samples = [row for row in rows if row.get("type") == "sample"]
counts = {}
for row in samples:
    counts[row["operation"]] = counts.get(row["operation"], 0) + 1
sample_count = ", ".join(f"{operation}={counts[operation]}" for operation in sorted(counts)) or "unknown"
cache_rows = [row for row in rows if row.get("type") == "build_cache"]
cache_hit = cache_rows[0].get("exact_hit", "unknown") if len(cache_rows) == 1 else "unknown"
if isinstance(cache_hit, bool):
    cache_hit = str(cache_hit).lower()

def shown(name: str) -> str:
    value = metadata.get(name, "unknown")
    return str(value) if value not in (None, "") else "unknown"

print(f"- Commit SHA: `{shown('commit_sha')}`")
print(f"- Swift image: `{shown('swift_image')}`")
print(f"- Image digest: `{shown('image_digest')}`")
print(f"- Runner: `{shown('runner_os')}/{shown('runner_arch')}`")
print(f"- GITHUB_RUN_ID: `{shown('github_run_id')}`")
print(f"- GITHUB_RUN_ATTEMPT: `{shown('github_run_attempt')}`")
print(f"- Swift version full: `{shown('swift_version_full')}`")
print(f"- Kernel: `{shown('kernel')}`")
print(f"- CPU model: `{shown('cpu_model')}`")
print(f"- CPU count: `{shown('cpu_count')}`")
print(f"- Baseline runs: **{shown('baseline_runs')}**")
print(f"- Raw samples: **{sample_count}**")
print(f"- Build cache exact hit: **{cache_hit}**")
PY
  else
    python3 - "${metadata_file}" <<'PY'
import json
import sys

metadata = json.loads(next(line for line in open(sys.argv[1], encoding="utf-8") if line.strip()))

def shown(name: str) -> str:
    value = metadata.get(name, "unknown")
    return str(value) if value not in (None, "") else "unknown"

print(f"- Commit SHA: `{shown('commit_sha')}`")
print(f"- Swift image: `{shown('swift_image')}`")
print(f"- Image digest: `{shown('image_digest')}`")
print(f"- Runner: `{shown('runner_os')}/{shown('runner_arch')}`")
print(f"- GITHUB_RUN_ID: `{shown('github_run_id')}`")
print(f"- GITHUB_RUN_ATTEMPT: `{shown('github_run_attempt')}`")
print(f"- Swift version full: `{shown('swift_version_full')}`")
print(f"- Kernel: `{shown('kernel')}`")
print(f"- CPU model: `{shown('cpu_model')}`")
print(f"- CPU count: `{shown('cpu_count')}`")
print(f"- Baseline runs: **{shown('baseline_runs')}**")
print("- Raw samples: **unknown**")
print("- Build cache exact hit: **unknown**")
PY
  fi
  echo
  echo '> **Healthy means:** guarded metrics show **✅ Pass**. CPU metrics are **ℹ️ Observe** until enough CI history exists for a stable threshold.'
  echo
  echo '| Operation | Metric | Result | Value | Better | Guardrail | Aggregation | Workload | Spread (raw) | N |'
  echo '|---|---|:---:|---:|:---:|---|---|---|---|---:|'

  if [ ! -f "${LOG_FILE}" ]; then
    echo '| — | Metrics unavailable | ⚠️ Unavailable | — | — | — | — | — | — | — |'
    echo
    echo '### How to read this'
    echo
    echo '- **Throughput:** synthetic in-memory SMB transfer rate. Higher is better; calibrated catastrophic floors are shown per operation.'
    echo '- **User/System CPU:** CPU consumed during the measured transfer. Lower is better, but currently informational because hosted-runner variance needs more history.'
    echo '- **Process max RSS:** peak memory for the entire XCTest process, not a per-operation allocation delta. It can repeat across read/write rows; the job fails at 512 MiB or above.'
    echo '- **Measured duration:** each aggregated sample must cover at least 200 ms of transfer-only intervals to reduce timer and scheduler noise.'
    echo '- Compare trends between runs of this same Linux Release job. Values from macOS, Debug builds, or real-network E2E are not directly comparable.'
  elif [ "${parse_status}" -ne 0 ]; then
    echo '| — | Metrics unavailable | ❌ Parse failed | — | — | — | — | — | — | — |'
    echo
    echo '- **Parse failed:** resource-performance.log violated the log contract. This step exits non-zero to fail the job.'
    exit "${parse_status}"
  else
    python3 - "${validated_jsonl}" <<'PY'
from __future__ import annotations

import json
import statistics
import sys
from decimal import Decimal


def fixed(value: Decimal) -> str:
    return f"{value:.3f}"


def general(value: str) -> str:
    rendered = format(Decimal(value), "f")
    if "." in rendered:
        rendered = rendered.rstrip("0").rstrip(".")
    return rendered or "0"


def median(values: list[Decimal]) -> Decimal:
    return Decimal(str(statistics.median(values)))


def metric_number(metric: str, value: Decimal) -> str:
    if metric == "max_rss_kb":
        return f"{value / Decimal(1024):.1f} MiB"
    unit = {
        "throughput_mib_s": "MiB/s",
        "user_cpu_ms": "ms",
        "system_cpu_ms": "ms",
        "sample_elapsed_ms": "ms",
    }[metric]
    return f"{fixed(value)} {unit}"


def spread(metric: str, values: list[Decimal], raw: bool) -> str:
    if not values:
        return "—"
    low = min(values)
    high = max(values)
    rendered_range = f"{metric_number(metric, low)}–{metric_number(metric, high)}"
    if raw:
        return rendered_range
    representative_median = median(values)
    mad = median([abs(value - representative_median) for value in values])
    return f"MAD {metric_number(metric, mad)}; {rendered_range}"


rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
summaries = [row for row in rows if row.get("type") == "summary"]
samples = [row for row in rows if row.get("type") == "sample"]
summary_metrics = {}
for row in summaries:
    operation, metric = row["name"].split(".", 1)
    summary_metrics.setdefault((operation, metric), []).append(row)
sample_fields = {
    "throughput_mib_s": "throughput_mib_s",
    "user_cpu_ms": "user_cpu_ms",
    "system_cpu_ms": "system_cpu_ms",
    "sample_elapsed_ms": "elapsed_ms",
    "max_rss_kb": "max_rss_kb",
}
labels = {
    "throughput_mib_s": "Throughput",
    "user_cpu_ms": "User CPU",
    "system_cpu_ms": "System CPU",
    "sample_elapsed_ms": "Measured duration",
    "max_rss_kb": "Process max RSS",
}

for (operation, metric), metric_rows in summary_metrics.items():
    representative_values = [Decimal(row["value"]) for row in metric_rows]
    multiple_baselines = len({row["baseline_run"] for row in metric_rows}) > 1
    display_value_number = median(representative_values) if multiple_baselines else representative_values[0]
    display_value = metric_number(metric, display_value_number)
    raw_values = [Decimal(row[sample_fields[metric]]) for row in samples if row["operation"] == operation]
    distribution_values = representative_values if multiple_baselines else raw_values
    spread_value = spread(metric, distribution_values, raw=not multiple_baselines)
    n_value = len(distribution_values)
    label = labels[metric]
    direction = "—"
    guardrail = "Observation only"
    aggregation = "Median"
    result = "ℹ️ Observe"
    if metric == "throughput_mib_s":
        direction = "Higher ↑"
        guardrail = "> " + general(metric_rows[0]["throughput_floor_mib_s"]) + " MiB/s"
        result = "✅ Pass" if display_value_number > Decimal(metric_rows[0]["throughput_floor_mib_s"]) else "❌ Fail"
    elif metric in {"user_cpu_ms", "system_cpu_ms", "max_rss_kb"}:
        direction = "Lower ↓"
    elif metric == "sample_elapsed_ms":
        direction = "Stable window"
        guardrail = "≥ 200 ms"
        result = "✅ Pass" if display_value_number >= 200 else "❌ Too short"
    if metric == "max_rss_kb":
        guardrail = "< 512 MiB"
        aggregation = "Peak"
        result = "✅ Pass" if display_value_number < 524288 else "❌ Fail"
    workload = metric_rows[0]
    workload_text = f"{workload['size_mib']} MiB × {workload['runs']} runs × {workload['iterations']} iterations"
    print(f"| `{operation}` | {label} | {result} | {display_value} | {direction} | {guardrail} | {aggregation} | {workload_text} | {spread_value} | {n_value} |")

print()
print("### CPU efficiency (Observe-only)")
print()
print("These derived metrics are Observe-only and do not affect guardrail results or exit status.")
print("CPU utilization is reported as a ratio of user plus system CPU time to measured elapsed time.")
print()
print("| Operation | user ms/MiB | system ms/MiB | CPU utilization |")
print("|---|---:|---:|---:|")

derived_rows = [row for row in rows if row.get("type") == "derived"]
derived_metrics = {}
for row in derived_rows:
    for metric in ("user_cpu_ms_per_mib", "system_cpu_ms_per_mib", "cpu_utilization"):
        value = row.get(metric)
        if value is not None:
            derived_metrics.setdefault((row["operation"], metric), []).append(Decimal(str(value)))

def derived_display(operation: str, metric: str) -> str:
    values = derived_metrics.get((operation, metric), [])
    return fixed(median(values)) if values else "n/a"

for operation in ("read_stream", "write_stream"):
    print(
        f"| `{operation}` | {derived_display(operation, 'user_cpu_ms_per_mib')} "
        f"| {derived_display(operation, 'system_cpu_ms_per_mib')} "
        f"| {derived_display(operation, 'cpu_utilization')} |"
    )

print()
print("### How to read this")
print()
print("- **Throughput:** synthetic in-memory SMB transfer rate. Higher is better; calibrated catastrophic floors are shown per operation.")
print("- **User/System CPU:** CPU consumed during the measured transfer. Lower is better, but currently informational because hosted-runner variance needs more history.")
print("- **Process max RSS:** peak memory for the entire XCTest process, not a per-operation allocation delta. It can repeat across read/write rows; the job fails at 512 MiB or above.")
print("- **Measured duration:** each aggregated sample must cover at least 200 ms of transfer-only intervals to reduce timer and scheduler noise.")
print("- **Spread (raw):** with one baseline run, this is the raw sample min–max. With multiple runs, it is the representative-value MAD and min–max; N is the number of values used.")
print("- Compare trends between runs of this same Linux Release job. Values from macOS, Debug builds, or real-network E2E are not directly comparable.")

profiles = [row for row in rows if row.get("type") == "write_profile"]
if profiles:
    derived_stage_rows = [row for row in rows if row.get("type") == "derived_stage"]
    stage_shares = {
        (row["baseline_run"], row["stage"]): row.get("share_of_full_synthetic")
        for row in derived_stage_rows
    }
    print()
    print("### Write stage profile")
    print()
    print("| Stage | Median | Effective throughput | Share of full synthetic | Interpretation |")
    print("|---|---:|---:|---:|---|")
    for row in profiles:
        stage = row["stage"]
        interpretation = {
            "signing_only": "AES-CMAC cost",
            "session_no_outbound_retention": "Session + transport, discard writes",
            "full_synthetic": "End-to-end synthetic write",
        }.get(stage, "WRITE encoding only")
        share = stage_shares.get((row["baseline_run"], stage))
        share_display = fixed(Decimal(str(share))) if share is not None else "n/a"
        print(f"| {stage.replace('_', ' ')} | {fixed(Decimal(row['median_ms']))} ms | {fixed(Decimal(row['throughput_mib_s']))} MiB/s | {share_display} | {interpretation} |")

process_rows = [row for row in rows if row.get("type") == "process"]
if process_rows:
    process_rss = process_rows[-1]["value"]
    print()
    print("### Whole `swift test` process tree")
    print()
    print(f"- Compiler + XCTest maximum RSS: **{Decimal(process_rss) / Decimal(1024):.1f} MiB** ({process_rss} KiB). This is CI cost, not an operation allocation metric.")
PY
  fi
} >> "${SUMMARY_FILE}"
