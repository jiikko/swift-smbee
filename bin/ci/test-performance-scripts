#!/usr/bin/env bash
set -euo pipefail
set -E
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

temporary="$(mktemp -d)"
trap 'rm -rf "${temporary}"' EXIT

current_scenario=''

scenario_failed() {
  trap - ERR
  printf 'FAILED in scenario %s\n' "${current_scenario}" >&2
  exit 1
}

run_scenario() {
  current_scenario="$1"
  trap scenario_failed ERR
  "${current_scenario}"
  trap - ERR
}

new_scenario_dir() {
  mktemp -d "${temporary}/scenario.XXXXXX"
}

expect_contains() {
  local file="$1"
  shift
  local expected
  for expected in "$@"; do
    grep -F -- "${expected}" "${file}"
  done
}

write_docker_stub() {
  local scenario_dir="$1"
  cat > "${scenario_dir}/docker" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [ "${1:-}" = image ] && [ "${2:-}" = inspect ]; then
  printf '%s\n' "${DOCKER_STUB_IMAGE_DIGEST:-}"
  exit 0
fi
if [ -n "${DOCKER_STUB_MARKER:-}" ]; then
  touch "${DOCKER_STUB_MARKER}"
fi
if [ -n "${DOCKER_STUB_LOG:-}" ]; then
  invocation_count_file="${DOCKER_STUB_LOG}.count"
  invocation_count=0
  if [ -f "${invocation_count_file}" ]; then
    invocation_count="$(cat "${invocation_count_file}")"
  fi
  invocation_count=$((invocation_count + 1))
  printf '%s\n' "${invocation_count}" > "${invocation_count_file}"
  printf '%s\n' "$@" > "${DOCKER_STUB_LOG}.${invocation_count}"
fi
EOF
  chmod +x "${scenario_dir}/docker"
}

run_resource_performance_without_docker() {
  local scenario_dir="$1"
  shift
  PATH="${scenario_dir}:${PATH}" \
  SWIFT_IMAGE=swift:test \
  DOCKER_STUB_MARKER="${scenario_dir}/docker-stub-called" \
    "$@"
}

write_canonical_log() {
  local log_file="$1"
  cat > "${log_file}" <<'EOF'
