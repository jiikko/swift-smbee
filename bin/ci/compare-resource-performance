#!/usr/bin/env bash
set -u
unset CDPATH

# Artifact selection belongs to the workflow; keeping this command file-to-file
# makes it deterministic and easy to test. Pass --fail-on-regression to enable
# the push-time gate after the Markdown comparison has been written.
python3 - "$@" <<'PY'
from __future__ import annotations

import json
import math
import random
import sys
from decimal import Decimal, InvalidOperation
from pathlib import Path


OPERATIONS = ("read_stream", "write_stream")
METRICS = ("throughput_mib_s", "user_cpu_ms", "system_cpu_ms", "max_rss_kb")
METADATA_KEYS = ("swift_image", "runner_os", "runner_arch", "cpu_model", "cpu_count")
REGRESSION_LIMITS = {
    "throughput_mib_s": Decimal("15"),
    "user_cpu_ms": Decimal("25"),
    "max_rss_kb": Decimal("20"),
}


class ComparableError(Exception):
    pass


def decimal(value: object, description: str) -> Decimal:
    if isinstance(value, bool) or value is None:
        raise ComparableError(f"{description} is not numeric")
    try:
        parsed = Decimal(str(value))
    except (InvalidOperation, ValueError):
        raise ComparableError(f"{description} is not numeric") from None
    if not parsed.is_finite():
        raise ComparableError(f"{description} is not finite")
    return parsed


def workload(row: dict[str, object], description: str) -> tuple[Decimal, int, int]:
    try:
        size = decimal(row["size_mib"], f"{description} size_mib")
        runs = int(row["runs"])
        iterations = int(row["iterations"])
    except (KeyError, TypeError, ValueError):
        raise ComparableError(f"{description} has an invalid workload") from None
    if runs < 1 or iterations < 1:
        raise ComparableError(f"{description} has an invalid workload")
    return size, runs, iterations


def median(values: list[Decimal]) -> Decimal:
    ordered = sorted(values)
    middle = len(ordered) // 2
    if len(ordered) % 2:
        return ordered[middle]
    return (ordered[middle - 1] + ordered[middle]) / Decimal(2)


def paired_inference(
    current: list[Decimal], reference: list[Decimal], seed: str
) -> tuple[float, float, float, float] | None:
    if len(current) != len(reference) or len(current) < 2:
        return None
    if any(value <= 0 for value in current + reference):
        return None
    differences = [
        math.log(float(current_value / reference_value))
        for current_value, reference_value in zip(current, reference)
    ]
    observed = abs(sum(differences) / len(differences))
    rng = random.Random(seed)
    bootstrap_means = []
    for _ in range(50_000):
        bootstrap_means.append(
            sum(differences[rng.randrange(len(differences))] for _ in differences) / len(differences)
        )
    bootstrap_means.sort()
    lower_log = bootstrap_means[int(len(bootstrap_means) * 0.025)]
    upper_log = bootstrap_means[int(len(bootstrap_means) * 0.975)]

    extreme = 0
    permutations = 1 << len(differences) if len(differences) <= 20 else 200_000
    for permutation in range(permutations):
        if len(differences) <= 20:
            signed_mean = sum(
                difference if permutation & (1 << index) else -difference
                for index, difference in enumerate(differences)
            ) / len(differences)
        else:
            signed_mean = sum(
                difference if rng.getrandbits(1) else -difference
                for difference in differences
            ) / len(differences)
        if abs(signed_mean) >= observed - 1e-15:
            extreme += 1
    p_value = extreme / permutations
    effect = math.expm1(sum(differences) / len(differences)) * 100
    lower = math.expm1(lower_log) * 100
    upper = math.expm1(upper_log) * 100
    return effect, lower, upper, p_value


def holm_adjust(p_values: list[float]) -> list[float]:
    adjusted = [1.0] * len(p_values)
    running_max = 0.0
    for rank, index in enumerate(sorted(range(len(p_values)), key=p_values.__getitem__)):
        candidate = min(1.0, p_values[index] * (len(p_values) - rank))
        running_max = max(running_max, candidate)
        adjusted[index] = running_max
    return adjusted


def load(path: Path, label: str) -> tuple[dict[str, object], dict[str, list[dict[str, object]]], dict[str, tuple[Decimal, int, int]]]:
    if not path.is_file():
        raise ComparableError(f"{label} JSONL is missing")
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        raise ComparableError(f"{label} JSONL could not be read") from None

    rows: list[dict[str, object]] = []
    for line_number, line in enumerate(lines, 1):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            raise ComparableError(f"{label} JSONL parse failure") from None
        if not isinstance(row, dict):
            raise ComparableError(f"{label} JSONL parse failure")
        if row.get("type") == "parse_failure":
            raise ComparableError(f"{label} JSONL contains parse_failure")
        rows.append(row)
    if not rows:
        raise ComparableError(f"{label} JSONL parse failure")

    metadata_rows = [row for row in rows if row.get("type") == "metadata"]
    if len(metadata_rows) != 1:
        raise ComparableError(f"{label} JSONL metadata is missing or duplicated")
    metadata = metadata_rows[0]
    for key in METADATA_KEYS:
        value = metadata.get(key)
        if not isinstance(value, str) or not value or value == "unknown":
            raise ComparableError(f"{label} metadata {key} is unavailable")

    summaries: dict[str, list[dict[str, object]]] = {
        f"{operation}.{metric}": []
        for operation in OPERATIONS
        for metric in METRICS
    }
    for row in rows:
        if row.get("type") != "summary":
            continue
        name = row.get("name")
        if isinstance(name, str) and name in summaries:
            summaries[name].append(row)

    workloads: dict[str, tuple[Decimal, int, int]] = {}
    for operation in OPERATIONS:
        operation_workloads: set[tuple[Decimal, int, int]] = set()
        for metric in METRICS:
            key = f"{operation}.{metric}"
            metric_rows = summaries[key]
            if not metric_rows:
                raise ComparableError(f"{label} JSONL is missing {key}")
            for row in metric_rows:
                operation_workloads.add(workload(row, f"{label} {key}"))
                decimal(row.get("value"), f"{label} {key} value")
        if len(operation_workloads) != 1:
            raise ComparableError(f"{label} JSONL has inconsistent {operation} workload")
        workloads[operation] = next(iter(operation_workloads))
    return metadata, summaries, workloads


def display_number(value: Decimal, metric: str) -> str:
    if metric == "max_rss_kb":
        return f"{value:.1f} KiB"
    unit = "MiB/s" if metric == "throughput_mib_s" else "ms"
    return f"{value:.3f} {unit}"


def percent_change(current: Decimal, reference: Decimal, metric: str) -> tuple[str, str]:
    if reference == 0:
        if current == 0:
            return "±0.0%", "unchanged"
        raise ComparableError(f"reference {metric} median is zero")
    change = (current - reference) / reference * Decimal(100)
    if not change:
        return "±0.0%", "unchanged"
    sign = "+" if change > 0 else ""
    if abs(change) < Decimal(10):
        return f"{sign}{change:.1f}%", "within noise"
    improved = (metric == "throughput_mib_s" and change > 0) or (metric != "throughput_mib_s" and change < 0)
    direction = "improved" if improved else "regressed"
    return f"{sign}{change:.1f}%", direction


def regression_percent(current: Decimal, reference: Decimal, metric: str) -> Decimal | None:
    if reference == 0 or metric not in REGRESSION_LIMITS:
        return None
    change = (current - reference) / reference * Decimal(100)
    return -change if metric == "throughput_mib_s" else change


def compare(current_path: Path, reference_path: Path, fail_on_regression: bool) -> bool:
    try:
        current_metadata, current_summaries, current_workloads = load(current_path, "current")
        reference_metadata, reference_summaries, reference_workloads = load(reference_path, "reference")
        metadata_mismatches = [
            key for key in METADATA_KEYS if current_metadata.get(key) != reference_metadata.get(key)
        ]
        if metadata_mismatches:
            raise ComparableError("metadata mismatch: " + ", ".join(metadata_mismatches))
        workload_mismatches = [
            operation for operation in OPERATIONS if current_workloads[operation] != reference_workloads[operation]
        ]
        if workload_mismatches:
            raise ComparableError("workload mismatch: " + ", ".join(workload_mismatches))

        results: list[dict[str, object]] = []
        for operation in OPERATIONS:
            for metric in METRICS:
                key = f"{operation}.{metric}"
                current_values = [decimal(row["value"], f"current {key} value") for row in current_summaries[key]]
                reference_values = [decimal(row["value"], f"reference {key} value") for row in reference_summaries[key]]
                current_median = median(current_values)
                reference_median = median(reference_values)
                change, direction = percent_change(current_median, reference_median, metric)
                results.append({
                    "operation": operation,
                    "metric": metric,
                    "current": current_median,
                    "reference": reference_median,
                    "direction": direction,
                    "change": change,
                    "inference": paired_inference(current_values, reference_values, key),
                })
    except ComparableError as error:
        suffix = "Regression gate skipped." if fail_on_regression else "Advisory only; this comparison does not affect guardrails or job status."
        print(f"## Resource performance history comparison\n\nNo comparable baseline ({error}).\n\n{suffix}")
        return False

    print("## Resource performance history comparison")
    print()
    if fail_on_regression:
        pair_count = len(current_summaries["read_stream.throughput_mib_s"])
        print(
            f"Regression gate: {pair_count} alternating current/reference pairs on the same runner. "
            "Paired effects use geometric mean ratios, deterministic 95% bootstrap confidence intervals, "
            "and two-sided sign-flip permutation tests."
        )
        print("Limits: throughput -15%, user CPU +25%, process RSS +20%. System CPU remains observe-only.")
    else:
        print("Advisory only: compared with the previous successful master push run; this does not affect guardrails or job status.")
    print(
        "Holm-adjusted p-values control the family-wise error rate across the reported metrics. "
        "Statistical significance does not imply a practically important change."
    )
    print()
    inferential_indexes = [index for index, result in enumerate(results) if result["inference"] is not None]
    adjusted_values = holm_adjust([
        results[index]["inference"][3]  # type: ignore[index]
        for index in inferential_indexes
    ])
    adjusted_by_index = dict(zip(inferential_indexes, adjusted_values))
    print("| Operation | Metric | Current median | Reference median | Change | Paired effect (95% CI; Holm p) |")
    print("|---|---|---:|---:|---|---|")
    for index, result in enumerate(results):
        operation = result["operation"]
        metric = result["metric"]
        current = result["current"]
        reference = result["reference"]
        inference = result["inference"]
        if inference is None:
            inference_text = "unavailable (zero or insufficient pairs)"
        else:
            effect, lower, upper, _ = inference
            inference_text = (
                f"{effect:+.2f}% ({lower:+.2f}% to {upper:+.2f}%; "
                f"p={adjusted_by_index[index]:.4f})"
            )
        print(
            f"| `{operation}` | `{metric}` | {display_number(current, metric)} | "
            f"{display_number(reference, metric)} | {result['direction']} ({result['change']}) | "
            f"{inference_text} |"
        )

    regressions = []
    for index, result in enumerate(results):
        operation = result["operation"]
        metric = result["metric"]
        current = result["current"]
        reference = result["reference"]
        regression = regression_percent(current, reference, metric)
        limit = REGRESSION_LIMITS.get(metric)
        adjusted_p = adjusted_by_index.get(index, 1.0)
        inference = result["inference"]
        pair_count = len(current_summaries[f"{operation}.{metric}"])
        statistically_confirmed = inference is not None and pair_count >= 10 and adjusted_p < 0.05
        insufficient_for_inference = pair_count < 10
        if (
            regression is not None
            and limit is not None
            and regression > limit
            and (statistically_confirmed or insufficient_for_inference)
        ):
            evidence = (
                f"Holm p={adjusted_p:.4f}"
                if statistically_confirmed
                else f"only {pair_count} pairs; practical-limit safeguard"
            )
            regressions.append(
                f"{operation}.{metric} regressed {regression:.1f}% "
                f"(limit {limit:.0f}%, {evidence})"
            )
    if fail_on_regression:
        print()
        if regressions:
            print("**Performance regression gate: FAIL**")
            for regression in regressions:
                print(f"- {regression}")
        else:
            print("**Performance regression gate: PASS**")
    return bool(regressions)


def main() -> int:
    fail_on_regression = len(sys.argv) == 4 and sys.argv[3] == "--fail-on-regression"
    if len(sys.argv) not in {3, 4} or (len(sys.argv) == 4 and not fail_on_regression):
        print("## Resource performance history comparison\n\nNo comparable baseline (current or reference JSONL argument is missing).\n\nAdvisory only; this comparison does not affect guardrails or job status.")
        return 0
    try:
        regressed = compare(Path(sys.argv[1]), Path(sys.argv[2]), fail_on_regression)
        return 1 if fail_on_regression and regressed else 0
    except Exception as error:
        suffix = "Regression gate skipped." if fail_on_regression else "Advisory only; this comparison does not affect guardrails or job status."
        print(f"## Resource performance history comparison\n\nNo comparable baseline (comparison failed: {error}).\n\n{suffix}")
        return 0


raise SystemExit(main())
PY
