#!/usr/bin/env bash
set -Eeuo pipefail
unset CDPATH

# Shape the Samba container boundary in both directions. RTT checks use direct
# Samba-container connections and exact-flow counters so proxy setup and unrelated traffic cannot validate a probe.
# Threat model: guards protect against this script's own misconfiguration and Samba container restart/replacement.
# External tc changes during measurement are out of scope; the hosted Actions runner has no other tc writer.
# SMBEE_E2E_PORT is the host-published port; direct probes and tc tuples use the Samba container backend port.
#
#   network-performance-study-rtt setup
#   network-performance-study-rtt set <0|5|20>
#   network-performance-study-rtt calibrate
#   network-performance-study-rtt verify <0|5|20> <zero-delay-median-ms>
#   network-performance-study-rtt guard <5|20>
#   network-performance-study-rtt show
#   network-performance-study-rtt clear

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
: "${SAMBA_CONTAINER:=smbee-samba-study}"
: "${SMBEE_E2E_BACKEND_PORT:=445}"
: "${STUDY_RTT_STATE_FILE:=.build/network-study/network-shape-state}"
: "${STUDY_RTT_JSONL:=${STUDY_RTT_STATE_FILE}.jsonl}"
SERVER_IFB=ifb-study
HOST_IFB=ifb-study-host
state_file="$STUDY_RTT_STATE_FILE"
jsonl_file="$STUDY_RTT_JSONL"
server_pid=""
server_ip=""
container_id=""
container_started=""
netns_inode=""
server_ifindex=""
peer_ifindex=""
host_veth=""
active_rtt=0
shaping_enabled=0
last_failed_command=""
probe_pid=""
probe_workdir=""

usage() {
  printf '%s\n' 'usage: network-performance-study-rtt <setup|set|calibrate|verify|guard|show|clear> [arguments]' >&2
  exit 2
}

valid_rtt() {
  case "$1" in
    0|5|20) return 0 ;;
    *) return 1 ;;
  esac
}

valid_milliseconds() {
  [[ "$1" =~ ^[0-9]{1,6}([.][0-9]{1,3})?$ ]]
}

delay_for_rtt() {
  case "$1" in
    0) printf '%s\n' 0ms ;;
    5) printf '%s\n' 2.5ms ;;
    20) printf '%s\n' 10ms ;;
    *) return 1 ;;
  esac
}

remove_path() {
  python3 - "$1" <<'PY'
import os
import shutil
import sys

path = sys.argv[1]
if os.path.isdir(path) and not os.path.islink(path):
    shutil.rmtree(path)
else:
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
PY
}

diagnostics() {
  [ "$shaping_enabled" -eq 1 ] || return 0
  printf '%s\n' '--- qdisc state on host ---' >&2
  sudo -n tc -s qdisc show >&2 2>&1 || true
  if [ -n "$server_pid" ]; then
    printf '%s\n' '--- qdisc state in Samba network namespace ---' >&2
    sudo -n nsenter -t "$server_pid" -n -- tc -s qdisc show >&2 2>&1 || true
  fi
}

fail() {
  local reason="$*" host_qdisc="" server_qdisc=""
  if [ -n "$probe_pid" ]; then
    kill "$probe_pid" 2>/dev/null || true
    wait "$probe_pid" 2>/dev/null || true
    probe_pid=""
  fi
  if [ -n "$probe_workdir" ]; then
    remove_path "$probe_workdir" || true
    probe_workdir=""
  fi
  if [ "$shaping_enabled" -eq 1 ]; then
    host_qdisc="$(sudo -n tc -s qdisc show 2>&1 || true)"
    if [ -n "$server_pid" ]; then
      server_qdisc="$(sudo -n nsenter -t "$server_pid" -n -- tc -s qdisc show 2>&1 || true)"
    fi
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$jsonl_file" "$active_rtt" "$reason" "$last_failed_command" \
      "$host_qdisc" "$server_qdisc" <<'PY' || true
import json
import sys

path, rtt, reason, command, host_qdisc, server_qdisc = sys.argv[1:]
try:
    requested = int(rtt) if rtt in ("0", "5", "20") else None
    row = {
        "event": "failure",
        "requested_rtt_ms": requested,
        "reason": reason,
        "failed_command": command or None,
        "host_qdisc": host_qdisc,
        "samba_qdisc": server_qdisc,
        "status": "measurement-unavailable",
    }
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(row, sort_keys=True) + "\n")
except OSError:
    pass
PY
  fi
  printf 'SHAPING FAILED — %s\n' "$reason" >&2
  diagnostics
  exit 1
}

run_required() {
  local rc output
  last_failed_command=""
  if output="$("$@" 2>&1)"; then
    [ -z "$output" ] || printf '%s\n' "$output"
    return 0
  else
    rc=$?
    last_failed_command="$(printf '%q ' "$@")"
    fail "command failed (exit $rc): $last_failed_command; output: $output"
  fi
}

capture_required() {
  local result rc
  if result="$("$@" 2>&1)"; then
    last_failed_command=""
    printf '%s\n' "$result"
  else
    rc=$?
    last_failed_command="$(printf '%q ' "$@")"
    fail "command failed (exit $rc): $last_failed_command; output: $result"
  fi
}

append_event() {
  mkdir -p "$(dirname "$jsonl_file")"
  printf '%s\n' "$1" >>"$jsonl_file"
}

append_probe_event() {
  local event="$1" rtt="$2" baseline="$3" measured="$4" delta="$5" status="$6"
  local host_qdisc="" server_qdisc="" host_filter="" server_filter=""
  if [ "$shaping_enabled" -eq 1 ]; then
    host_qdisc="$(capture_required sudo -n tc -s qdisc show dev "$HOST_IFB")"
    server_qdisc="$(capture_required namespace tc -s qdisc show dev "$SERVER_IFB")"
    host_filter="$(capture_required sudo -n tc filter show dev "$host_veth" parent ffff:)"
    server_filter="$(capture_required namespace tc filter show dev eth0 parent ffff:)"
  fi
  mkdir -p "$(dirname "$jsonl_file")"
  python3 - "$jsonl_file" "$event" "$rtt" "$baseline" "$measured" "$delta" \
    "$status" "$host_qdisc" "$server_qdisc" "$host_filter" "$server_filter" "$container_id" "$netns_inode" \
    "$server_ifindex" "$peer_ifindex" "$host_veth" <<'PY'
import json
import sys

path, event, rtt, baseline, measured, delta, status, host_qdisc, server_qdisc, \
    host_filter, server_filter, container_id, netns_inode, server_ifindex, peer_ifindex, host_veth = sys.argv[1:]
row = {
    "event": event,
    "requested_rtt_ms": int(rtt),
    "baseline_tcp_roundtrip_median_ms": float(baseline) if baseline else None,
    "tcp_roundtrip_median_ms": float(measured),
    "observed_delta_ms": float(delta) if delta else None,
    "status": status,
    "host_ifb_qdisc": host_qdisc or None,
    "samba_ifb_qdisc": server_qdisc or None,
    "host_ingress_filter": host_filter or None,
    "samba_ingress_filter": server_filter or None,
    "container_id": container_id or None,
    "netns_inode": int(netns_inode) if netns_inode.isdigit() else None,
    "server_ifindex": int(server_ifindex) if server_ifindex.isdigit() else None,
    "peer_ifindex": int(peer_ifindex) if peer_ifindex.isdigit() else None,
    "host_veth": host_veth or None,
}
with open(path, "a", encoding="utf-8") as handle:
    handle.write(json.dumps(row, sort_keys=True) + "\n")
PY
}

namespace() {
  sudo -n nsenter -t "$server_pid" -n -- "$@"
}

read_container_snapshot() {
  local record
  local field
  local -a fields=()
  record="$(capture_required docker inspect --format '{{.Id}}{{"\n"}}{{.State.StartedAt}}{{"\n"}}{{.State.Pid}}{{"\n"}}{{.NetworkSettings.IPAddress}}' "$SAMBA_CONTAINER")"
  while IFS= read -r field; do fields+=("$field"); done <<<"$record"
  [ "${#fields[@]}" -eq 4 ] || fail 'docker inspect returned an incomplete Samba container snapshot'
  container_id="${fields[0]}"
  container_started="${fields[1]}"
  server_pid="${fields[2]}"
  server_ip="${fields[3]}"
  [[ "$container_id" =~ ^[0-9a-fA-F]{12,64}$ ]] || fail "docker returned an invalid container ID: $container_id"
  [ -n "$container_started" ] || fail 'docker returned an empty container start time'
  [[ "$server_pid" =~ ^[0-9]{1,10}$ ]] && [ "$server_pid" -gt 0 ] || fail "docker returned an invalid Samba PID: $server_pid"
  if ! python3 - "$server_ip" <<'PY'
import ipaddress
import sys
ipaddress.IPv4Address(sys.argv[1])
PY
  then
    fail "docker returned an invalid Samba container IPv4 address: $server_ip"
  fi
}

read_topology() {
  local samba_links host_links resolved
  samba_links="$(capture_required sudo -n nsenter -t "$server_pid" -n -- ip -j -d link show dev eth0)"
  host_links="$(capture_required ip -j -d link show)"
  if resolved="$(python3 - "$samba_links" "$host_links" <<'PY'
import json
import sys

server_rows = json.loads(sys.argv[1])
host_rows = json.loads(sys.argv[2])
if len(server_rows) != 1 or server_rows[0].get("ifname") != "eth0":
    raise SystemExit("netlink did not return exactly Samba eth0")
server = server_rows[0]
server_index = server.get("ifindex")
peer_index = server.get("link_index")
server_kind = (server.get("linkinfo") or {}).get("info_kind")
if not isinstance(server_index, int) or server_index <= 0:
    raise SystemExit("Samba eth0 has no valid netlink ifindex")
if not isinstance(peer_index, int) or peer_index <= 0:
    raise SystemExit("Samba eth0 has no valid netlink peer link_index")
if server_kind != "veth":
    raise SystemExit("Samba eth0 is not a veth")
peers = [row for row in host_rows if row.get("ifindex") == peer_index]
if len(peers) != 1:
    raise SystemExit("host netlink did not resolve exactly one Samba veth peer")
peer = peers[0]
peer_kind = (peer.get("linkinfo") or {}).get("info_kind")
if peer_kind != "veth" or peer.get("link_index") != server_index:
    raise SystemExit("host interface is not the reciprocal veth peer of Samba eth0")
name = peer.get("ifname", "")
if not name or len(name) > 15 or not all(c.isalnum() or c in "_.:-" for c in name):
    raise SystemExit("host veth has an invalid interface name")
print(f"{server_index}\t{peer_index}\t{name}")
PY
  )"; then
    IFS=$'\t' read -r server_ifindex peer_ifindex host_veth <<<"$resolved"
  else
    fail "could not prove the Samba eth0 and host veth are reciprocal peers: $resolved"
  fi
  [[ "$server_ifindex" =~ ^[0-9]+$ && "$peer_ifindex" =~ ^[0-9]+$ ]] || fail 'netlink returned invalid veth indices'
  [[ "$host_veth" =~ ^[a-zA-Z0-9_.:-]{1,15}$ ]] || fail "invalid host veth name: $host_veth"
}

capture_boundary() {
  read_container_snapshot
  netns_inode="$(capture_required sudo -n stat -Lc %i "/proc/$server_pid/ns/net")"
  [[ "$netns_inode" =~ ^[0-9]+$ ]] || fail "invalid Samba network namespace inode: $netns_inode"
  read_topology
}

save_state() {
  mkdir -p "$(dirname "$state_file")"
  printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
    "$container_id" "$container_started" "$server_pid" "$server_ip" "$netns_inode" \
    "$server_ifindex" "$peer_ifindex" "$host_veth" >"$state_file"
  shaping_enabled=1
}

load_state() {
  if [ ! -f "$state_file" ]; then
    return 1
  fi
  local field
  local -a fields=()
  while IFS= read -r field; do fields+=("$field"); done <"$state_file"
  [ "${#fields[@]}" -eq 8 ] || fail 'RTT setup state is malformed'
  container_id="${fields[0]}"
  container_started="${fields[1]}"
  server_pid="${fields[2]}"
  server_ip="${fields[3]}"
  netns_inode="${fields[4]}"
  server_ifindex="${fields[5]}"
  peer_ifindex="${fields[6]}"
  host_veth="${fields[7]}"
  [[ "$container_id" =~ ^[0-9a-fA-F]{12,64}$ ]] || fail 'RTT setup state has an invalid container ID'
  [[ "$server_pid" =~ ^[0-9]{1,10}$ && "$netns_inode" =~ ^[0-9]+$ ]] || fail 'RTT setup state has invalid PID or namespace inode'
  [[ "$host_veth" =~ ^[a-zA-Z0-9_.:-]{1,15}$ ]] || fail 'RTT setup state has an invalid host veth'
  shaping_enabled=1
}

assert_boundary_unchanged() {
  local old_id old_started old_pid old_ip old_inode old_server_index old_peer_index old_host
  old_id="$container_id"
  old_started="$container_started"
  old_pid="$server_pid"
  old_ip="$server_ip"
  old_inode="$netns_inode"
  old_server_index="$server_ifindex"
  old_peer_index="$peer_ifindex"
  old_host="$host_veth"
  capture_boundary
  if [ "$container_id" != "$old_id" ] || [ "$container_started" != "$old_started" ] || [ "$server_pid" != "$old_pid" ]; then
    fail "Samba container generation changed (ID/start/PID $old_id/$old_started/$old_pid -> $container_id/$container_started/$server_pid)"
  fi
  if [ "$netns_inode" != "$old_inode" ]; then
    fail "Samba network namespace inode changed ($old_inode -> $netns_inode)"
  fi
  if [ "$server_ip" != "$old_ip" ] || [ "$server_ifindex" != "$old_server_index" ] || \
    [ "$peer_ifindex" != "$old_peer_index" ] || [ "$host_veth" != "$old_host" ]; then
    fail "Samba veth peer changed (server $old_server_index, host $old_host/$old_peer_index -> server $server_ifindex, host $host_veth/$peer_ifindex)"
  fi
}

assert_shaping_state() {
  local rtt="$1" delay host_qdisc server_qdisc host_filters server_filters
  delay="$(delay_for_rtt "$rtt")"
  host_qdisc="$(capture_required sudo -n tc -j qdisc show dev "$HOST_IFB")"
  server_qdisc="$(capture_required namespace tc -j qdisc show dev "$SERVER_IFB")"
  host_filters="$(capture_required sudo -n tc -j filter show dev "$host_veth" parent ffff:)"
  server_filters="$(capture_required namespace tc -j filter show dev eth0 parent ffff:)"
  if ! python3 - "$delay" "$HOST_IFB" "$SERVER_IFB" "$host_qdisc" "$server_qdisc" \
    "$host_filters" "$server_filters" <<'PY'
import json
import math
import sys

delay, host_ifb, server_ifb, host_qdisc, server_qdisc, host_filters, server_filters = sys.argv[1:]

def json_rows(output, label):
    try:
        rows = json.loads(output)
    except json.JSONDecodeError as error:
        raise SystemExit(f"{label} is not valid tc JSON: {error}") from error
    if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
        raise SystemExit(f"{label} is not a tc JSON row array")
    return rows

def qdisc_matches(output, expected_ms):
    rows = json_rows(output, "qdisc readback")
    candidates = [row for row in rows if row.get("kind") == "netem" and row.get("root") is True]
    if len(candidates) != 1:
        return False
    options = candidates[0].get("options")
    if not isinstance(options, dict):
        return False
    # iproute2 omits q_netem's delay object when latency is zero. In tc -j,
    # a present delay value is expressed in seconds; absence therefore means 0.
    if "delay" not in options:
        observed_seconds = 0.0
    else:
        delay_object = options["delay"]
        if not isinstance(delay_object, dict) or "delay" not in delay_object:
            return False
        observed_seconds = delay_object["delay"]
    if isinstance(observed_seconds, bool) or not isinstance(observed_seconds, (int, float)):
        return False
    # The kernel keeps netem latency in scheduler ticks; a 2.5 ms request reads back as
    # 0.00249997 s on the GitHub runner. 1 us is far below the 2.5 ms step between levels.
    return math.isclose(observed_seconds, expected_ms / 1000.0, rel_tol=0.0, abs_tol=1e-6)

def is_node(row):
    options = row.get("options")
    if not isinstance(options, dict):
        return False
    if row.get("kind") == "flower":
        return options.get("handle") not in (None, "", 0)
    # Summary rows carry an empty options object; the concrete classifier node has
    # classifier-specific options, even when it has no action (for example, a classid).
    return bool(options)

def action_rows(row):
    actions = row.get("options", {}).get("actions", [])
    return actions if isinstance(actions, list) else []

def control_type(action):
    control = action.get("control_action")
    return control.get("type") if isinstance(control, dict) else None

def redirect_to(row, target):
    actions = action_rows(row)
    return len(actions) == 1 and actions[0].get("kind") == "mirred" and \
        actions[0].get("mirred_action") == "redirect" and actions[0].get("direction") == "egress" and \
        actions[0].get("to_dev") == target

def only_continues(row):
    actions = action_rows(row)
    return bool(actions) and all(
        action.get("kind") == "gact" and control_type(action) in ("continue", "pipe")
        for action in actions
    )

def can_match_ipv4(protocol):
    # Explicit non-IPv4 EtherTypes cannot match the probe's IPv4 packets. Treat an
    # omitted or unfamiliar protocol as potentially matching, so an unknown earlier
    # terminal node cannot silently bypass the pref 1000 redirect.
    non_ipv4 = {"ipv6", "arp", "rarp", "802.2", "802.3", "pppoed", "pppoes", "mpls_uc", "mpls_mc"}
    return protocol not in non_ipv4

def check_filters(output, target, label):
    rows = json_rows(output, f"{label} ingress filter readback")
    nodes = [row for row in rows if is_node(row)]
    expected = [row for row in nodes
                if row.get("pref") == 1000 and row.get("chain", 0) == 0 and
                row.get("protocol") == "all" and row.get("kind") == "matchall" and redirect_to(row, target)]
    if len(expected) != 1:
        raise SystemExit(f"{label} ingress has no unique chain 0 protocol all pref 1000 matchall redirect to {target}")
    for row in nodes:
        if row.get("chain", 0) != 0:
            continue
        pref = row.get("pref")
        if not isinstance(pref, int):
            raise SystemExit(f"{label} ingress has a filter node without a numeric preference: {row}")
        if pref >= 1000:
            continue
        if can_match_ipv4(row.get("protocol")) and not only_continues(row):
            raise SystemExit(f"{label} ingress has a terminal or unknown filter before pref 1000: {row}")

if not qdisc_matches(host_qdisc, float(delay[:-2])):
    raise SystemExit(f"host IFB qdisc does not report root netem delay {delay}: {host_qdisc}")
if not qdisc_matches(server_qdisc, float(delay[:-2])):
    raise SystemExit(f"Samba IFB qdisc does not report root netem delay {delay}: {server_qdisc}")
check_filters(host_filters, host_ifb, "host")
check_filters(server_filters, server_ifb, "Samba")
PY
  then
    fail "tc readback does not match requested RTT $rtt ms (delay $delay) or expected bidirectional redirects"
  fi
}

assert_current_state() {
  local rtt="$1"
  load_state || fail 'setup state is missing; run setup first'
  assert_boundary_unchanged
  assert_shaping_state "$rtt"
}

set_delay() {
  local rtt="$1" delay
  active_rtt="$rtt"
  valid_rtt "$rtt" || fail "RTT must be one of 0, 5, or 20 ms: $rtt"
  if [ "$rtt" = 0 ]; then
    # With no active shaper the default condition is a true no-op. A mixed run
    # uses this command only to reset before its next nonzero calibration.
    if load_state; then
      assert_boundary_unchanged
      run_required sudo -n tc qdisc replace dev "$HOST_IFB" root netem delay 0ms
      run_required namespace tc qdisc replace dev "$SERVER_IFB" root netem delay 0ms
      assert_shaping_state 0
    fi
    printf '%s\n' 'RTT 0 requested; no shaping command issued without active nonzero study state'
    return 0
  fi
  load_state || fail 'setup state is missing; run setup first'
  assert_boundary_unchanged
  delay="$(delay_for_rtt "$rtt")"
  run_required sudo -n tc qdisc replace dev "$HOST_IFB" root netem delay "$delay"
  run_required namespace tc qdisc replace dev "$SERVER_IFB" root netem delay "$delay"
  assert_shaping_state "$rtt"
  printf 'Configured requested RTT %s ms (%s each direction)\n' "$rtt" "$delay"
}

setup_boundary() {
  local command_name
  for command_name in docker ip nsenter tc sudo awk python3 stat modprobe; do
    command -v "$command_name" >/dev/null 2>&1 || fail "required command is unavailable: $command_name"
  done
  run_required sudo -n true
  capture_boundary
  save_state
}

cmd_setup() {
  shaping_enabled=1
  setup_boundary
  run_required sudo -n modprobe ifb
  run_required sudo -n ip link add "$HOST_IFB" type ifb
  run_required sudo -n ip link set dev "$HOST_IFB" up
  run_required sudo -n tc qdisc replace dev "$HOST_IFB" root netem delay 0ms
  run_required sudo -n tc qdisc add dev "$host_veth" handle ffff: ingress
  run_required sudo -n tc filter replace dev "$host_veth" parent ffff: protocol all pref 1000 matchall \
    action mirred egress redirect dev "$HOST_IFB"
  run_required namespace ip link add "$SERVER_IFB" type ifb
  run_required namespace ip link set dev "$SERVER_IFB" up
  run_required namespace tc qdisc replace dev "$SERVER_IFB" root netem delay 0ms
  run_required namespace tc qdisc add dev eth0 handle ffff: ingress
  run_required namespace tc filter replace dev eth0 parent ffff: protocol all pref 1000 matchall \
    action mirred egress redirect dev "$SERVER_IFB"
  assert_shaping_state 0
  append_event "{\"event\":\"setup\",\"mode\":\"ifb-tc-netem-on-reciprocal-veth\",\"container_id\":\"$container_id\",\"started_at\":\"$container_started\",\"server_pid\":$server_pid,\"netns_inode\":$netns_inode,\"server_ifindex\":$server_ifindex,\"peer_ifindex\":$peer_ifindex,\"host_veth\":\"$host_veth\",\"server_ip\":\"$server_ip\"}"
  printf 'RTT shaping active: Samba eth0 ingress + host veth ingress -> IFB\n'
}

direct_probe() {
  local measured
  if measured="$(python3 "$SCRIPT_DIR/network-performance-study-rtt-probe.py" direct "$server_ip" "$SMBEE_E2E_BACKEND_PORT")"; then
    printf '%s\n' "$measured"
  else
    fail 'direct-to-container SMB2 NEGOTIATE RTT probe could not complete all 15 roundtrips'
  fi
}

read_filter_counts() {
  local side="$1" output counts rc
  local -a tc_command=()
  if [ "$side" = host ]; then
    tc_command=(sudo -n tc -s filter show dev "$host_veth" parent ffff:)
  else
    tc_command=(sudo -n nsenter -t "$server_pid" -n -- tc -s filter show dev eth0 parent ffff:)
  fi
  if output="$("${tc_command[@]}" 2>&1)"; then :; else
    rc=$?
    last_failed_command="$(printf '%q ' "${tc_command[@]}")"
    fail "could not read $side probe filter counters: command failed (exit $rc): $last_failed_command; output: $output"
  fi
  if counts="$(printf '%s\n' "$output" | awk '
    /^filter / {
      selected = 0
      for (field = 1; field < NF; field++) {
        if ($field == "pref" && $(field + 1) ~ /^[0-9]+$/ &&
            $(field + 1) >= 101 && $(field + 1) <= 115) {
          selected = 1
          selected_pref = $(field + 1)
        }
      }
    }
    selected && /Sent/ {
      for (field = 1; field <= NF; field++) {
        if ($field == "pkt" && field > 1) {
          value = $(field - 1)
          if (value ~ /^[0-9]+$/) {
            print selected_pref "\t" value
            found[selected_pref] = 1
            selected = 0
          }
        }
      }
    }
    END {
      for (wanted = 101; wanted <= 115; wanted++) {
        if (!found[wanted]) exit 1
      }
    }
  ')"; then :; else
    fail "tc packet counter is missing or non-integer for $side probe filters pref 101-115"
  fi
  printf '%s\n' "$counts"
}

check_probe_filters() {
  local client_ip="$1" host_filters server_filters
  shift
  local -a ports=("$@")
  host_filters="$(capture_required sudo -n tc -j filter show dev "$host_veth" parent ffff:)"
  server_filters="$(capture_required namespace tc -j filter show dev eth0 parent ffff:)"
  if ! python3 - "$host_filters" "$server_filters" "$client_ip" "$server_ip" \
    "$SMBEE_E2E_BACKEND_PORT" "${ports[@]}" <<'PY'
import json
import sys

host_output, server_output, client_ip, server_ip, server_port, *ports = sys.argv[1:]

def rows_for(output, side):
    try:
        rows = json.loads(output)
    except json.JSONDecodeError as error:
        raise SystemExit(f"{side} tc flower dump is not valid JSON: {error}") from error
    if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
        raise SystemExit(f"{side} tc flower dump is not a JSON row array")
    return rows

def check_side(rows, side):
    for index, client_port in enumerate(ports, start=1):
        pref = 100 + index
        # Classifier dumps may include a summary row. Select only the handle-bearing node.
        nodes = [row for row in rows if row.get("pref") == pref and row.get("kind") == "flower" and
                 isinstance(row.get("options"), dict) and
                 row["options"].get("handle") not in (None, "", 0)]
        if len(nodes) != 1:
            raise SystemExit(f"expected exactly one handle-bearing probe flower node at pref {pref}")
        node = nodes[0]
        if node.get("protocol") != "ip" or node.get("chain", 0) != 0:
            raise SystemExit(f"probe flower node at pref {pref} must use protocol ip and chain 0")
        keys = node["options"].get("keys")
        if not isinstance(keys, dict):
            raise SystemExit(f"probe flower node at pref {pref} has no structured keys")
        expected = {
            "ip_proto": "tcp",
            "src_ip": server_ip if side == "host" else client_ip,
            "src_port": int(server_port) if side == "host" else int(client_port),
            "dst_ip": client_ip if side == "host" else server_ip,
            "dst_port": int(client_port) if side == "host" else int(server_port),
        }
        missing = [key for key, value in expected.items() if str(keys.get(key)) != str(value)]
        if missing:
            raise SystemExit(f"probe flower node at pref {pref} does not match the exact flow: {missing}")
        actions = node["options"].get("actions")
        if not isinstance(actions, list) or len(actions) != 1 or actions[0].get("kind") != "gact" or \
                actions[0].get("control_action", {}).get("type") != "continue":
            raise SystemExit(f"probe flower node at pref {pref} must count and continue classification")

check_side(rows_for(host_output, "host"), "host")
check_side(rows_for(server_output, "Samba"), "Samba")
PY
  then
    fail 'tc readback does not match the exact probe flows or continuation action'
  fi
}

install_probe_filter() {
  local side="$1" pref="$2" client_ip="$3" client_port="$4"
  if [ "$side" = host ]; then
    run_required sudo -n tc filter replace dev "$host_veth" parent ffff: protocol ip pref "$pref" flower \
      ip_proto tcp src_ip "$server_ip" src_port "$SMBEE_E2E_BACKEND_PORT" dst_ip "$client_ip" dst_port "$client_port" \
      action gact continue
  else
    namespace tc filter replace dev eth0 parent ffff: protocol ip pref "$pref" flower \
      ip_proto tcp src_ip "$client_ip" src_port "$client_port" dst_ip "$server_ip" dst_port "$SMBEE_E2E_BACKEND_PORT" \
      action gact continue
  fi
}

cleanup_command() {
  local output rc
  if output="$("$@" 2>&1)"; then
    return 0
  else
    rc=$?
    if printf '%s' "$output" | grep -Eqi 'cannot find qdisc|cannot find device|no such (file|device|process)|does not exist|specified priority/protocol not found'; then
      return 0
    fi
    printf 'RTT cleanup command failed (exit %s): %s\n%s\n' "$rc" "$*" "$output" >&2
    return 1
  fi
}

delete_probe_filters() {
  local side="$1" pref failed=0
  for ((pref = 101; pref <= 115; pref++)); do
    if [ "$side" = host ]; then
      cleanup_command sudo -n tc filter del dev "$host_veth" parent ffff: pref "$pref" || failed=1
    else
      cleanup_command namespace tc filter del dev eth0 parent ffff: pref "$pref" || failed=1
    fi
  done
  return "$failed"
}

run_targeted_probe() {
  local probe_dir client_ip i pref port before_server_counts before_host_counts after_server_counts after_host_counts output measured
  local -a before_host=() before_server=() probe_info=()
  probe_dir="$(mktemp -d)"
  probe_workdir="$probe_dir"
  python3 "$SCRIPT_DIR/network-performance-study-rtt-probe.py" hold "$server_ip" "$SMBEE_E2E_BACKEND_PORT" "$probe_dir" \
    >"$probe_dir/worker.out" 2>"$probe_dir/worker.err" &
  probe_pid=$!
  for _ in $(seq 1 300); do
    if [ -s "$probe_dir/ready" ]; then break; fi
    if ! kill -0 "$probe_pid" 2>/dev/null; then
      wait "$probe_pid" || true
      probe_pid=""
      fail "SMB2 RTT probe could not establish direct sessions: $(cat "$probe_dir/worker.err")"
    fi
    sleep 0.1
  done
  [ -s "$probe_dir/ready" ] || fail 'timed out waiting for direct SMB2 RTT probe sessions'
  while IFS= read -r port; do probe_info+=("$port"); done <"$probe_dir/ready"
  client_ip="${probe_info[0]:-}"
  [ "${#probe_info[@]}" -eq 16 ] || fail "SMB2 RTT probe did not open exactly 15 sessions (read ${#probe_info[@]} fields)"
  for ((i = 1; i <= 15; i++)); do
    port="${probe_info[i]:-}"
    [[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -gt 0 ] || fail "invalid SMB2 probe source port: $port"
    pref=$((100 + i))
    install_probe_filter server "$pref" "$client_ip" "$port"
    install_probe_filter host "$pref" "$client_ip" "$port"
  done
  check_probe_filters "$client_ip" "${probe_info[@]:1}"
  before_server_counts="$(read_filter_counts server)"
  before_host_counts="$(read_filter_counts host)"
  while IFS=$'\t' read -r pref port; do
    i=$((pref - 100))
    before_server[i]="$port"
  done <<<"$before_server_counts"
  while IFS=$'\t' read -r pref port; do
    i=$((pref - 100))
    before_host[i]="$port"
  done <<<"$before_host_counts"
  touch "$probe_dir/go"
  if wait "$probe_pid"; then
    probe_pid=""
  else
    probe_pid=""
    output="$(cat "$probe_dir/worker.err" 2>/dev/null || true)"
    delete_probe_filters host || true
    delete_probe_filters server || true
    remove_path "$probe_dir"
    probe_workdir=""
    fail "SMB2 RTT probe failed before all 15 responses: $output"
  fi
  measured="$(cat "$probe_dir/result")"
  valid_milliseconds "$measured" || fail "TCP RTT probe returned an invalid median: $measured"
  after_server_counts="$(read_filter_counts server)"
  after_host_counts="$(read_filter_counts host)"
  local -a after_server=() after_host=()
  while IFS=$'\t' read -r pref port; do
    i=$((pref - 100))
    after_server[i]="$port"
  done <<<"$after_server_counts"
  while IFS=$'\t' read -r pref port; do
    i=$((pref - 100))
    after_host[i]="$port"
  done <<<"$after_host_counts"
  for ((i = 1; i <= 15; i++)); do
    pref=$((100 + i))
    # Each already-connected session sends a request and receives a response. Requiring every
    # unique four-tuple on both ingress filters prevents unrelated traffic from satisfying a probe.
    if [ "$((after_server[i] - before_server[i]))" -lt 1 ]; then
      fail "Samba-side exact-flow filter pref $pref did not count its SMB probe request (counter ${before_server[i]} -> ${after_server[i]})"
    fi
    if [ "$((after_host[i] - before_host[i]))" -lt 1 ]; then
      fail "host-side exact-flow filter pref $pref did not count its SMB probe response (counter ${before_host[i]} -> ${after_host[i]})"
    fi
  done
  delete_probe_filters host || fail 'could not remove the host probe filters after measurement'
  delete_probe_filters server || fail 'could not remove the Samba probe filters after measurement'
  remove_path "$probe_dir"
  probe_workdir=""
  printf '%s\n' "$measured"
}

measure_and_check_packets() {
  local measured
  if load_state; then
    assert_current_state "$active_rtt"
    measured="$(run_targeted_probe)" || fail 'targeted TCP SMB2 NEGOTIATE RTT probe failed'
    assert_current_state "$active_rtt"
  else
    # Zero-only runs do not require or inspect tc state. They still use direct container IP.
    read_container_snapshot
    measured="$(direct_probe)"
  fi
  valid_milliseconds "$measured" || fail "TCP RTT probe returned an invalid median: $measured"
  printf '%s\n' "$measured"
}

cmd_calibrate() {
  local measured
  active_rtt=0
  if load_state; then
    assert_current_state 0
  fi
  measured="$(measure_and_check_packets)"
  append_probe_event calibrate 0 "" "$measured" "" pass
  printf '%s\n' "$measured"
}

cmd_verify() {
  local rtt="$1" baseline="$2" measured delta tolerance
  active_rtt="$rtt"
  valid_rtt "$rtt" || fail "RTT must be one of 0, 5, or 20 ms: $rtt"
  valid_milliseconds "$baseline" || fail "zero-delay baseline must be a millisecond value: $baseline"
  if [ "$rtt" = 0 ] && [ ! -f "$state_file" ]; then
    shaping_enabled=0
  else
    load_state || fail 'setup state is missing for a nonzero RTT; run setup first'
    assert_current_state "$rtt"
  fi
  measured="$(measure_and_check_packets)"
  case "$rtt" in
    0) tolerance=2 ;;
    5) tolerance=1 ;;
    20) tolerance=2 ;;
  esac
  # Accept iff abs((measured median - zero-delay median) - requested RTT) <= tolerance.
  # ±1 ms at 5 ms and ±2 ms at 20 ms allow timer scheduling and short-run noise while
  # rejecting half-delay or absent-delay results. The 0 ms tolerance is ±2 ms because
  # it compares two independent medians of 15 request/response samples.
  delta="$(awk -v measured="$measured" -v baseline="$baseline" 'BEGIN { printf "%.3f", measured - baseline }')"
  if ! awk -v delta="$delta" -v wanted="$rtt" -v tolerance="$tolerance" \
    'BEGIN { if (delta < wanted - tolerance || delta > wanted + tolerance) exit 1 }'; then
    append_probe_event verify "$rtt" "$baseline" "$measured" "$delta" measurement-unavailable
    last_failed_command='TCP SMB2 NEGOTIATE RTT calibration comparison'
    fail "RTT injection ineffective: requested $rtt ms, observed $delta ms (allowed ±$tolerance ms); arm is measurement unavailable"
  fi
  if [ "$rtt" != 0 ] || [ -f "$state_file" ]; then
    assert_current_state "$rtt"
  fi
  append_probe_event verify "$rtt" "$baseline" "$measured" "$delta" pass
  printf '%s\n' "$measured"
}

cmd_guard() {
  local rtt="$1"
  valid_rtt "$rtt" && [ "$rtt" != 0 ] || fail 'guard requires an active 5 or 20 ms shaping level'
  assert_current_state "$rtt"
  printf 'RTT %s ms boundary and bidirectional shaper state verified\n' "$rtt"
}

cmd_show() {
  if ! load_state; then
    printf '%s\n' 'No RTT shaping state is active'
    return 0
  fi
  printf 'Samba container: %s\nContainer ID: %s\nStarted: %s\nPID: %s\nNetwork namespace inode: %s\nSamba ifindex: %s\nPeer ifindex: %s\nHost veth: %s\nSamba IP: %s\n' \
    "$SAMBA_CONTAINER" "$container_id" "$container_started" "$server_pid" "$netns_inode" \
    "$server_ifindex" "$peer_ifindex" "$host_veth" "$server_ip"
  sudo -n tc -s qdisc show
  namespace tc -s qdisc show
}

cmd_clear() {
  local failed=0 pref
  if ! load_state; then
    printf '%s\n' 'No RTT shaping state to clear'
    return 0
  fi
  if [ -n "$server_pid" ]; then
    for ((pref = 101; pref <= 115; pref++)); do
      cleanup_command sudo -n nsenter -t "$server_pid" -n -- tc filter del dev eth0 parent ffff: pref "$pref" || failed=1
      cleanup_command sudo -n tc filter del dev "$host_veth" parent ffff: pref "$pref" || failed=1
    done
    cleanup_command sudo -n nsenter -t "$server_pid" -n -- tc qdisc del dev eth0 ingress || failed=1
    cleanup_command sudo -n nsenter -t "$server_pid" -n -- ip link del dev "$SERVER_IFB" || failed=1
  fi
  if [ -n "$host_veth" ]; then
    cleanup_command sudo -n tc qdisc del dev "$host_veth" ingress || failed=1
  fi
  cleanup_command sudo -n ip link del dev "$HOST_IFB" || failed=1
  if [ "$failed" -ne 0 ]; then
    diagnostics
    return 1
  fi
  remove_path "$state_file"
  shaping_enabled=0
  printf '%s\n' 'RTT qdiscs, filters, and IFB devices cleared'
}

if [ "$#" -lt 1 ]; then usage; fi
action="$1"
shift
case "$action" in
  setup) [ "$#" -eq 0 ] || usage; cmd_setup ;;
  set) [ "$#" -eq 1 ] || usage; set_delay "$1" ;;
  calibrate) [ "$#" -eq 0 ] || usage; cmd_calibrate ;;
  verify) [ "$#" -eq 2 ] || usage; cmd_verify "$1" "$2" ;;
  guard) [ "$#" -eq 1 ] || usage; cmd_guard "$1" ;;
  show) [ "$#" -eq 0 ] || usage; cmd_show ;;
  clear) [ "$#" -eq 0 ] || usage; cmd_clear ;;
  *) usage ;;
esac
