  DOCKER_STUB_IMAGE_DIGEST='swift:test@sha256:deadbeef' \
  PATH="${scenario_dir}:${PATH}" \
    "${SCRIPT_DIR}/write-resource-performance-artifact"

  local compare_reference="${scenario_dir}/compare-reference.jsonl"
  local compare_metadata_mismatch="${scenario_dir}/compare-metadata-mismatch.jsonl"
  local compare_workload_mismatch="${scenario_dir}/compare-workload-mismatch.jsonl"
  local compare_parse_failure="${scenario_dir}/compare-parse-failure.jsonl"
  python3 - "${jsonl_file}" "${compare_reference}" "${compare_metadata_mismatch}" "${compare_workload_mismatch}" "${compare_parse_failure}" <<'PY'
import copy
import json
import sys
from decimal import Decimal

source, reference_path, metadata_path, workload_path, parse_failure_path = sys.argv[1:]
rows = [json.loads(line) for line in open(source, encoding="utf-8") if line.strip()]

reference = copy.deepcopy(rows)
for row in reference:
    if row.get("type") != "summary":
        continue
    metric = row["name"].split(".", 1)[1]
    value = Decimal(str(row["value"]))
    if metric == "throughput_mib_s":
        row["value"] = float(value / 2)
    elif metric in {"user_cpu_ms", "system_cpu_ms", "max_rss_kb"}:
        row["value"] = float(value * 2)

metadata_mismatch = copy.deepcopy(rows)
next(row for row in metadata_mismatch if row.get("type") == "metadata")["runner_os"] = "OtherOS"

workload_mismatch = copy.deepcopy(rows)
for row in workload_mismatch:
    if row.get("type") == "summary" and row["name"].startswith("read_stream."):
        row["size_mib"] = 999

parse_failure = [row for row in rows if row.get("type") == "metadata"]
parse_failure.append({"type": "parse_failure", "error": "fixture parse failure"})

for path, fixture in (
    (reference_path, reference),
    (metadata_path, metadata_mismatch),
    (workload_path, workload_mismatch),
    (parse_failure_path, parse_failure),
):
    with open(path, "w", encoding="utf-8") as stream:
        for row in fixture:
            stream.write(json.dumps(row, separators=(",", ":")) + "\n")
PY

  local compare_output="${scenario_dir}/compare-output.md"
  local compare_status=0
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${compare_reference}" \
    >"${compare_output}" || compare_status=$?
  test "${compare_status}" -eq 0
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${compare_output}" \
    '| `read_stream` | `throughput_mib_s` | 737.364 MiB/s | 368.682 MiB/s | improved (+100.0%) | +100.00%' \
    '| `read_stream` | `user_cpu_ms` | 200.000 ms | 400.000 ms | improved (-50.0%) | -50.00%' \
    '| `write_stream` | `system_cpu_ms` | 0.000 ms | 0.000 ms | unchanged (±0.0%) | unavailable' \
    'Holm-adjusted p-values' \
    'Advisory only'
  if grep -Eq '✅|❌|Pass|Fail' "${compare_output}"; then
    echo 'comparison unexpectedly included guardrail status' >&2
    return 1
  fi

  local gate_output="${scenario_dir}/gate-output.md"
  if "${SCRIPT_DIR}/compare-resource-performance" \
    "${compare_reference}" "${jsonl_file}" --fail-on-regression >"${gate_output}"; then
    echo 'performance gate unexpectedly accepted a severe regression' >&2
    return 1
  fi
  expect_contains "${gate_output}" \
    'Regression gate: 2 alternating current/reference pairs on the same runner.' \
    '**Performance regression gate: FAIL**' \
    'read_stream.throughput_mib_s regressed 50.0% (limit 15%, only 2 pairs; practical-limit safeguard)' \
    'write_stream.user_cpu_ms regressed 100.0% (limit 25%, only 2 pairs; practical-limit safeguard)'

  local passing_gate_output="${scenario_dir}/passing-gate-output.md"
  "${SCRIPT_DIR}/compare-resource-performance" \
    "${jsonl_file}" "${compare_reference}" --fail-on-regression >"${passing_gate_output}"
  expect_contains "${passing_gate_output}" '**Performance regression gate: PASS**'

  local no_baseline_output="${scenario_dir}/no-baseline.md"
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${scenario_dir}/missing-reference.jsonl" \
    >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'No comparable baseline (reference JSONL is missing).'
  "${SCRIPT_DIR}/compare-resource-performance" \
    "${jsonl_file}" "${scenario_dir}/missing-reference.jsonl" --fail-on-regression >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'Regression gate skipped.'
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${compare_metadata_mismatch}" \
    >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'No comparable baseline (metadata mismatch: runner_os).'
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${compare_workload_mismatch}" \
    >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'No comparable baseline (workload mismatch: read_stream).'
  "${SCRIPT_DIR}/compare-resource-performance" "${jsonl_file}" "${compare_parse_failure}" \
    >"${no_baseline_output}"
  expect_contains "${no_baseline_output}" 'No comparable baseline (reference JSONL contains parse_failure).'

  local baseline_summary="${scenario_dir}/baseline.md"
  "${SCRIPT_DIR}/summarize-resource-baseline" "${jsonl_file}" >"${baseline_summary}"
  # Literal Markdown backticks are intentional.
  # shellcheck disable=SC2016
  expect_contains "${baseline_summary}" \
    '# SMBee resource performance baseline' \
    '| `read_stream.throughput_mib_s` | 2 | 737.364 | 737.364 | 737.364 | 0.000 | 0.0000 | 737.364 | 737.364 |' \
    '| `pure_swift_signing_only` | 2 | 1280.738 | 1280.738 | 1280.738 | 0.000 | 0.0000 | 1280.738 | 1280.738 |' \
