#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
LOG_FILE="${RESOURCE_PERFORMANCE_LOG:-${REPO_ROOT}/.build/resource-performance.log}"
SUMMARY_FILE="${GITHUB_STEP_SUMMARY:?GITHUB_STEP_SUMMARY is required}"

{
  echo '## SMBee resource performance'
  echo
  echo '> **Healthy means:** guarded metrics show **✅ Pass**. CPU metrics are **ℹ️ Observe** until enough CI history exists for a stable threshold.'
  echo
  echo '| Operation | Metric | Result | Value | Better | Guardrail | Aggregation | Workload |'
  echo '|---|---|:---:|---:|:---:|---|---|---|'
  if [ -f "${LOG_FILE}" ]; then
    awk '
      /^PERF_RESOURCE / {
        full_name = $2
        split(full_name, name_parts, ".")
        operation = name_parts[1]
        metric = full_name
        sub("^" operation "\\.", "", metric)
        value = size = runs = iterations = ""
        for (field_index = 3; field_index <= NF; field_index++) {
          split($field_index, pair, "=")
          if (pair[1] == "value") value = pair[2]
          if (pair[1] == "size_mib") size = pair[2]
          if (pair[1] == "runs") runs = pair[2]
          if (pair[1] == "iterations") iterations = pair[2]
        }
        label = metric
        display_value = value
        direction = "—"
        guardrail = "Observation only"
        aggregation = "Median"
        result = "ℹ️ Observe"
        if (metric == "throughput_mib_s") {
          label = "Throughput"
          display_value = value " MiB/s"
          direction = "Higher ↑"
          guardrail = "> 5 MiB/s"
          result = (value + 0 > 5) ? "✅ Pass" : "❌ Fail"
        } else if (metric == "user_cpu_ms") {
          label = "User CPU"
          display_value = value " ms"
          direction = "Lower ↓"
        } else if (metric == "system_cpu_ms") {
          label = "System CPU"
          display_value = value " ms"
          direction = "Lower ↓"
        } else if (metric == "sample_elapsed_ms") {
          label = "Measured duration"
          display_value = value " ms"
          direction = "Stable window"
          guardrail = "≥ 200 ms"
          result = (value + 0 >= 200) ? "✅ Pass" : "❌ Too short"
        } else if (metric == "max_rss_kb") {
          label = "Process max RSS"
          display_value = sprintf("%.1f MiB", (value + 0) / 1024)
          direction = "Lower ↓"
          guardrail = "< 512 MiB"
          aggregation = "Peak"
          result = (value + 0 < 524288) ? "✅ Pass" : "❌ Fail"
        }
        printf "| `%s` | %s | %s | %s | %s | %s | %s | %s MiB × %s runs × %s iterations |\n", operation, label, result, display_value, direction, guardrail, aggregation, size, runs, iterations
        found = 1
      }
      END {
        if (!found) print "| — | Metrics unavailable | ⚠️ Unavailable | — | — | — | — | — |"
      }
    ' "${LOG_FILE}"
  else
    echo '| — | Metrics unavailable | ⚠️ Unavailable | — | — | — | — | — |'
  fi
  echo
  echo '### How to read this'
  echo
  echo '- **Throughput:** synthetic in-memory SMB transfer rate. Higher is better; the job fails at 5 MiB/s or below.'
  echo '- **User/System CPU:** CPU consumed during the measured transfer. Lower is better, but currently informational because hosted-runner variance needs more history.'
  echo '- **Process max RSS:** peak memory for the entire XCTest process, not a per-operation allocation delta. It can repeat across read/write rows; the job fails at 512 MiB or above.'
  echo '- **Measured duration:** each aggregated sample must cover at least 200 ms of transfer-only intervals to reduce timer and scheduler noise.'
  echo '- Compare trends between runs of this same Linux Release job. Values from macOS, Debug builds, or real-network E2E are not directly comparable.'
  if [ -f "${LOG_FILE}" ]; then
    process_rss="$(awk -F: '/Maximum resident set size \(kbytes\)/ { value=$2; gsub(/[[:space:]]/, "", value) } END { print value }' "${LOG_FILE}")"
    if [ -n "${process_rss}" ]; then
      echo
      # Literal Markdown backticks must not become shell command substitution.
      # shellcheck disable=SC2016
      echo '### Whole `swift test` process tree'
      echo
      printf -- '- Compiler + XCTest maximum RSS: **%.1f MiB** (%s KiB). This is CI cost, not an operation allocation metric.\n' "$((process_rss / 1024))" "${process_rss}"
    fi
  fi
} >> "${SUMMARY_FILE}"
