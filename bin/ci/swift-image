#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
version="$(tr -d '[:space:]' < "${REPO_ROOT}/.swift-version")"

if [ -z "${version}" ]; then
  echo ".swift-version is empty" >&2
  exit 1
fi

digest_file="${REPO_ROOT}/.swift-image-digest"
if [ -e "${digest_file}" ]; then
  digest="$(<"${digest_file}")"
  if [[ ! "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "Invalid Swift image digest in ${digest_file}: expected sha256:[0-9a-f]{64}" >&2
    exit 1
  fi
  printf 'swift:%s@%s\n' "${version}" "${digest}"
else
  # Keep the tag-only fallback for local checkouts that predate digest pinning.
  printf 'swift:%s\n' "${version}"
fi
