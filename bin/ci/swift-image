#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
version="$(tr -d '[:space:]' < "${REPO_ROOT}/.swift-version")"

if [ -z "${version}" ]; then
  echo ".swift-version is empty" >&2
  exit 1
fi

printf 'swift:%s\n' "${version}"
