#!/usr/bin/env python3
"""Summarize the issue 097 real-Samba transfer study.

Reads the JSONL that SMBeeNetworkPerformanceE2ETests writes (one line per measured sample, with the
workflow's metadata merged in) and prints a Markdown report:

- correctness: every sample must have size_matches=true, and every verified sample sha256_matches=true;
  otherwise the script exits 1 (a wrong transfer must not be summarized as a fast one)
- per (profile, arm, RTT target, size, operation): take the median of each invocation first, then report
  median / p10 / p90 / MAD / min / max over those invocation medians (raw samples are never pooled)
- --compare BEFORE:AFTER: before/after tables for two arms. A difference counts only when it exceeds
  both 3 x noise and 5% of the before median, where noise is the larger of the two arms' MADs
  (issue 097 "before / after の比較方法"). Groups whose fixed metadata differ are reported as
  incomparable instead of compared.

Percentiles use nearest rank. usage:
  summarize-network-performance-study [--expect-invocations N] [--compare before:after]... FILE.jsonl...

--expect-invocations N rejects a partial run: every (profile, arm, size, operation) group must have
invocations 1..N, each with its declared measured_iterations samples.
"""
import argparse
import json
import math
import statistics
import sys
from collections import defaultdict

METRICS = [
    ("throughput_mib_s", "MiB/s"),
    ("wall_ms", "ms"),
    ("client_cpu_ms", "ms"),
]
# Every sample of a compared pair must agree on these (issue 097 "固定するもの").
FIXED_METADATA = [
    "runner_cpu_model",
    "runner_cpu_count",
    "runner_image",
    "kernel",
    "docker_version",
    "swift_image_digest",
    "samba_base",
    "samba_version",
    "negotiated_dialect",
    "negotiated_signing",
    "negotiated_signing_required",
    "negotiated_cipher",
    "harness_commit",
    "rtt_target_ms",
]
# Below this many invocations per arm there is no usable noise estimate (MAD of one value is 0).
MIN_COMPARABLE_INVOCATIONS = 3
REQUIRED = ["profile", "arm", "invocation", "operation", "size_bytes", "wall_ms", "throughput_mib_s",
            "client_user_cpu_ms", "client_system_cpu_ms", "size_matches", "rtt_target_ms"]


def nearest_rank(values, quantile):
    ordered = sorted(values)
    rank = max(1, math.ceil(quantile * len(ordered)))
    return ordered[min(rank, len(ordered)) - 1]


def mad(values):
    center = statistics.median(values)
    return statistics.median(abs(value - center) for value in values)


def load(paths):
    samples = []
    for path in paths:
        with open(path, encoding="utf-8") as handle:
            for number, line in enumerate(handle, 1):
                if not line.strip():
                    continue
                try:
                    sample = json.loads(line)
                except json.JSONDecodeError as error:
                    raise SystemExit(f"{path}:{number}: invalid JSON: {error}")
                missing = [key for key in REQUIRED if key not in sample]
                if missing:
                    raise SystemExit(f"{path}:{number}: missing {', '.join(missing)}")
                if type(sample["rtt_target_ms"]) is not int or sample["rtt_target_ms"] not in (0, 5, 20):
                    raise SystemExit(f"{path}:{number}: rtt_target_ms must be one of 0, 5, or 20")
                sample["client_cpu_ms"] = sample["client_user_cpu_ms"] + sample["client_system_cpu_ms"]
                samples.append(sample)
    if not samples:
        raise SystemExit("no samples")
    return samples


def check_correctness(samples):
    failures = [
        sample for sample in samples
        if sample["size_matches"] is not True or sample.get("sha256_matches") is False
    ]
    if failures:
        first = failures[0]
        raise SystemExit(
            f"{len(failures)} sample(s) failed size/SHA-256 verification "
            f"(first: {first['profile']} {first['arm']} {first['operation']} "
            f"size={first['size_bytes']} invocation={first['invocation']} iteration={first.get('iteration')})"
        )
    verified = sum(1 for sample in samples if sample.get("sha256_matches") is True)
    return verified


def check_completeness(samples, expected_invocations):
    counts = defaultdict(lambda: defaultdict(int))
    declared = {}
    for sample in samples:
        key = group_key(sample)
        counts[key][sample["invocation"]] += 1
        declared[(key, sample["invocation"])] = sample.get("measured_iterations")
    problems = []
    for key, invocations in sorted(counts.items()):
        if sorted(invocations) != list(range(1, expected_invocations + 1)):
            problems.append(f"{key}: invocations {sorted(invocations)} != 1..{expected_invocations}")
        for invocation, count in invocations.items():
            wanted = declared[(key, invocation)]
            if wanted is not None and count != wanted:
                problems.append(f"{key} invocation {invocation}: {count} samples != measured_iterations {wanted}")
    if problems:
        raise SystemExit("incomplete study data:\n" + "\n".join(problems[:20]))


def group_key(sample):
    return (sample["profile"], sample["arm"], sample["rtt_target_ms"], sample["size_bytes"], sample["operation"])


def invocation_medians(samples):
    """{group: {metric: [median of each invocation]}} plus the metadata values seen per group."""
    by_invocation = defaultdict(lambda: defaultdict(list))
    metadata = defaultdict(lambda: defaultdict(set))
    for sample in samples:
        key = group_key(sample)
        by_invocation[key][sample["invocation"]].append(sample)
        for field in FIXED_METADATA:
            metadata[key][field].add(json.dumps(sample.get(field)))
    medians = {}
    for key, invocations in by_invocation.items():
        medians[key] = {
            metric: [statistics.median(s[metric] for s in rows) for _, rows in sorted(invocations.items())]
            for metric, _ in METRICS
        }
    return medians, metadata


def stats(values):
    return {
        "n": len(values),
        "median": statistics.median(values),
        "p10": nearest_rank(values, 0.10),
        "p90": nearest_rank(values, 0.90),
        "mad": mad(values),
        "min": min(values),
        "max": max(values),
    }


def size_label(size_bytes):
    return f"{size_bytes / 1_048_576:g} MiB"


def print_distribution(medians):
    print("### Invocation medians")
    print()
    print("| Profile | Arm | Added RTT | Size | Operation | Metric | Invocations | Median | p10 | p90 | MAD | Min | Max |")
    print("|---|---|---:|---:|---|---|---:|---:|---:|---:|---:|---:|---:|")
    for key in sorted(medians):
        profile, arm, rtt_target_ms, size_bytes, operation = key
        for metric, unit in METRICS:
            s = stats(medians[key][metric])
            print(
                f"| {profile} | {arm} | {rtt_target_ms} ms | {size_label(size_bytes)} | {operation} | {metric} ({unit}) | {s['n']} | "
                f"{s['median']:.3f} | {s['p10']:.3f} | {s['p90']:.3f} | {s['mad']:.3f} | "
                f"{s['min']:.3f} | {s['max']:.3f} |"
            )
    print()


def decide(before, after):
    noise = max(before["mad"], after["mad"])
    change = after["median"] - before["median"]
    relative = change / before["median"] if before["median"] else math.inf
    if abs(change) > 3 * noise and abs(relative) > 0.05:
        return relative, "difference"
    return relative, "within noise"


def print_comparison(medians, metadata, before_arm, after_arm):
    print(f"### {before_arm} → {after_arm}")
    print()
    print("| Profile | Added RTT | Size | Metric | Before median / MAD | After median / MAD | Change | Decision |")
    print("|---|---:|---:|---|---:|---:|---:|---|")
    rows = 0
    targets = sorted({(p, r, s, o) for (p, a, r, s, o) in medians if a in (before_arm, after_arm)})
    for profile, rtt_target_ms, size_bytes, operation in targets:
        before_key = (profile, before_arm, rtt_target_ms, size_bytes, operation)
        after_key = (profile, after_arm, rtt_target_ms, size_bytes, operation)
        if before_key not in medians or after_key not in medians:
            continue
        differing = [
            field for field in FIXED_METADATA
            if len(metadata[before_key][field] | metadata[after_key][field]) > 1
        ]
        for metric, unit in METRICS:
            before = stats(medians[before_key][metric])
            after = stats(medians[after_key][metric])
            label = f"{operation} {metric} ({unit})"
            if differing:
                decision = f"incomparable ({', '.join(differing)})"
                change = "—"
            elif before["n"] != after["n"] or before["n"] < MIN_COMPARABLE_INVOCATIONS:
                decision = f"insufficient invocations ({before['n']} vs {after['n']}; need equal and >= {MIN_COMPARABLE_INVOCATIONS})"
                change = "—"
            else:
                relative, decision = decide(before, after)
                change = f"{relative * 100:+.1f}%"
            print(
                f"| {profile} | {rtt_target_ms} ms | {size_label(size_bytes)} | {label} | "
                f"{before['median']:.3f} / {before['mad']:.3f} | {after['median']:.3f} / {after['mad']:.3f} | "
                f"{change} | {decision} |"
            )
            rows += 1
    if rows == 0:
        print(f"| — | — | no group has both {before_arm} and {after_arm} | — | — | — | — |")
    print()


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--compare", action="append", default=[], metavar="BEFORE:AFTER")
    parser.add_argument("--expect-invocations", type=int, metavar="N")
    parser.add_argument("files", nargs="+")
    arguments = parser.parse_args()

    samples = load(arguments.files)
    verified = check_correctness(samples)
    if arguments.expect_invocations is not None:
        check_completeness(samples, arguments.expect_invocations)
    medians, metadata = invocation_medians(samples)

    print("## Samba network performance study (issue 097)")
    print()
    print(
        f"{len(samples)} samples; all sizes matched; {verified} SHA-256 verifications passed. "
        "Statistics are over per-invocation medians (nearest-rank percentiles)."
    )
    print()
    print_distribution(medians)
    for pair in arguments.compare:
        if pair.count(":") != 1:
            raise SystemExit(f"--compare expects BEFORE:AFTER, got {pair}")
        before_arm, after_arm = pair.split(":")
        print_comparison(medians, metadata, before_arm, after_arm)


if __name__ == "__main__":
    sys.exit(main())
