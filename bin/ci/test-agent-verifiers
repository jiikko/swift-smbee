#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
temporary="$(mktemp -d)"
trap 'rm -rf "${temporary}"' EXIT

fail() {
  echo "test-agent-verifiers: $*" >&2
  exit 1
}

# verify-agent-push reads the git history next to it, so it runs from a scratch repository whose
# shape each scenario controls (the real HEAD may or may not be an issue-only commit).
repo="${temporary}/repo"
mkdir -p "${repo}/bin/ci" "${repo}/Sources" "${repo}/issues"
cp "${SCRIPT_DIR}/verify-agent-push" "${SCRIPT_DIR}/gh-retry" "${repo}/bin/ci/"
git_repo() {
  git -C "${repo}" -c user.name=test -c user.email=test@example.test "$@"
}
commit_all() {
  git_repo add -A >/dev/null
  git_repo commit -q --allow-empty -m "$1"
  git_repo rev-parse HEAD
}
git_repo init -q
printf 'one\n' >"${repo}/Sources/a.swift"
base_sha="$(commit_all base)"
printf 'two\n' >"${repo}/Sources/a.swift"
code_sha="$(commit_all code)"
printf '# 001\n' >"${repo}/issues/001-task-x.md"
issue_sha="$(commit_all issue)"
printf '# 001 more\n' >>"${repo}/issues/001-task-x.md"
issue2_sha="$(commit_all issue2)"
git_repo mv Sources/a.swift issues/a.swift
moved_sha="$(commit_all move-out-of-sources)"

runs_dir="${temporary}/runs"
mkdir -p "${runs_dir}"
# write_runs <sha> <conclusion-or-progress> <workflow...>
write_runs() {
  local sha="$1" kind="$2" name id=0 status conclusion
  shift 2
  {
    printf '['
    for name in "$@"; do
      id=$((id + 1))
      case "${kind}" in
        progress) status=in_progress; conclusion='' ;;
        *) status=completed; conclusion="${kind}" ;;
      esac
      [ "${id}" -gt 1 ] && printf ','
      printf '{"databaseId":%s,"name":"%s","status":"%s","conclusion":"%s","url":"https://example.test/%s","headSha":"%s"}' \
        "${id}" "${name}" "${status}" "${conclusion}" "${name}" "${sha}"
    done
    printf ']\n'
  } >"${runs_dir}/${sha}.json"
}
reset_runs() {
  rm -f "${runs_dir}"/*.json
}

cat >"${temporary}/gh" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail

if [ "${GH_STUB_MODE:-}" = retry ]; then
  count=0
  if [ -f "${GH_STUB_COUNT}" ]; then
    count="$(cat "${GH_STUB_COUNT}")"
  fi
  count=$((count + 1))
  printf '%s\n' "${count}" >"${GH_STUB_COUNT}"
  if [ "${count}" -lt 3 ]; then
    echo "temporary GitHub failure" >&2
    exit 1
  fi
  echo "retry recovered"
  exit 0
fi

if [ "${1:-}" = run ] && [ "${2:-}" = list ]; then
  sha=''
  while [ "$#" -gt 0 ]; do
    if [ "$1" = --commit ]; then
      sha="$2"
    fi
    shift
  done
  if [ -f "${GH_STUB_RUNS_DIR}/${sha}.json" ]; then
    cat "${GH_STUB_RUNS_DIR}/${sha}.json"
  else
    echo '[]'
  fi
  exit 0
fi

if [ "${1:-}" = run ] && [ "${2:-}" = view ]; then
  if printf '%s\n' "$@" | grep -q -- --log-failed; then
    echo "/work/Test.swift:42: error: XCTAssertTrue failed"
  else
    echo "  failure: failing E2E job (https://example.test/job/202)"
  fi
  exit 0
fi

echo "unexpected gh invocation: $*" >&2
exit 2
STUB
chmod +x "${temporary}/gh"

cat >"${temporary}/performance-verifier" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$1" >"${PERFORMANCE_STUB_MARKER}"
echo "performance artifacts verified"
STUB
chmod +x "${temporary}/performance-verifier"

# verify <name> <commit> [extra env...]: runs verify-agent-push; output in <name>.out/.err, rc in <name>.rc
verify() {
  local name="$1" commit="$2" rc=0
  shift 2
  env PATH="${temporary}:${PATH}" \
    GH_STUB_RUNS_DIR="${runs_dir}" \
    GH_RETRY_ATTEMPTS=1 \
    AGENT_PUSH_VERIFY_TIMEOUT_SECONDS=1 \
    AGENT_PUSH_VERIFY_POLL_SECONDS=1 \
    PERFORMANCE_STUB_MARKER="${temporary}/${name}.performance" \
    AGENT_PUSH_VERIFY_PERFORMANCE_COMMAND="${temporary}/performance-verifier" \
    "$@" \
    "${repo}/bin/ci/verify-agent-push" "${commit}" \
    >"${temporary}/${name}.out" 2>"${temporary}/${name}.err" || rc=$?
  printf '%s\n' "${rc}" >"${temporary}/${name}.rc"
}
expect_rc() {
  [ "$(<"${temporary}/$1.rc")" = "$2" ] || {
    cat "${temporary}/$1.out" "${temporary}/$1.err" >&2
    fail "$1: expected rc $2, got $(<"${temporary}/$1.rc")"
  }
}
expect_out() {
  grep -Fq -- "$2" "${temporary}/$1.$3" || {
    cat "${temporary}/$1.out" "${temporary}/$1.err" >&2
    fail "$1: missing in $3: $2"
  }
}

# gh-retry
retry_output="$(
  PATH="${temporary}:${PATH}" \
  GH_STUB_MODE=retry \
  GH_STUB_COUNT="${temporary}/retry-count" \
  GH_RETRY_ATTEMPTS=3 \
  GH_RETRY_INITIAL_DELAY=0 \
  GH_RETRY_MAX_DELAY=0 \
    "${SCRIPT_DIR}/gh-retry" gh run list 2>"${temporary}/retry.err"
)"
test "${retry_output}" = "retry recovered"
test "$(<"${temporary}/retry-count")" -eq 3
grep -Fq 'GitHub CLI attempt 1/3 failed' "${temporary}/retry.err"

# A commit that changes code: all four workflows on the commit itself.
reset_runs
write_runs "${code_sha}" success Test E2E Performance Issues
verify code-success "${code_sha}"
expect_rc code-success 0
expect_out code-success 'Test        completed    success' out
expect_out code-success 'Verified push CI for commit' out
test "$(<"${temporary}/code-success.performance")" = "${code_sha}"

reset_runs
write_runs "${code_sha}" success Test Performance Issues
write_runs "${code_sha}.e2e" failure E2E
python3 - "${runs_dir}/${code_sha}.json" "${runs_dir}/${code_sha}.e2e.json" "${code_sha}" <<'PY'
import json, sys
runs = json.load(open(sys.argv[1]))
e2e = json.load(open(sys.argv[2]))
for run in e2e:
    run["headSha"] = sys.argv[3]
    run["databaseId"] = 202
json.dump(runs + e2e, open(sys.argv[1], "w"))
PY
verify code-failure "${code_sha}"
expect_rc code-failure 1
expect_out code-failure 'E2E workflow failed' err
expect_out code-failure 'failing E2E job' err
expect_out code-failure 'XCTAssertTrue failed' err
test ! -e "${temporary}/code-failure.performance"

reset_runs
write_runs "${code_sha}" progress Test E2E Performance Issues
verify code-progress "${code_sha}"
expect_rc code-progress 1
expect_out code-progress 'Test=in_progress E2E=in_progress Performance=in_progress' out
expect_out code-progress 'Timed out waiting for all required workflows' err
test ! -e "${temporary}/code-progress.performance"

# A newer workflow_dispatch Performance run on the same commit (Performance with reference_sha) is
# not the push CI: the verifier must keep using the push run.
reset_runs
write_runs "${code_sha}" success Test E2E Performance Issues
python3 - "${runs_dir}/${code_sha}.json" "${code_sha}" <<'DISPATCH'
import json, sys
path, sha = sys.argv[1:3]
runs = json.load(open(path))
runs.insert(0, {"databaseId": 99, "name": "Performance", "status": "completed", "conclusion": "failure",
                "url": "https://example.test/dispatch", "headSha": sha, "event": "workflow_dispatch"})
json.dump(runs, open(path, "w"))
DISPATCH
verify code-ignores-dispatch "${code_sha}"
expect_rc code-ignores-dispatch 0
expect_out code-ignores-dispatch 'Performance completed    success' out

# Issues runs on every push, so it is required on a code commit too.
reset_runs
write_runs "${code_sha}" success Test E2E Performance
verify code-missing-issues "${code_sha}"
expect_rc code-missing-issues 1
expect_out code-missing-issues 'Issues=missing' out

# Issue-only commits pushed separately: paths-ignore skips Test/E2E/Performance, so they are taken
# from the code commit; Issues must pass on the commit itself.
reset_runs
write_runs "${code_sha}" success Test E2E Performance
write_runs "${issue2_sha}" success Issues
verify issue-ancestor "${issue2_sha}"
expect_rc issue-ancestor 0
expect_out issue-ancestor "Test, E2E, and Performance verified on ${code_sha}" out
expect_out issue-ancestor 'Issues      completed    success' out
test "$(<"${temporary}/issue-ancestor.performance")" = "${code_sha}"

# The issue commit was the tip of a push that also carried code: its own runs win.
reset_runs
write_runs "${code_sha}" failure Test E2E Performance
write_runs "${issue_sha}" success Test E2E Performance Issues
verify issue-tip-runs "${issue_sha}"
expect_rc issue-tip-runs 0
test "$(<"${temporary}/issue-tip-runs.performance")" = "${issue_sha}"

# Issues is required on the commit itself, not on the ancestor that carries the code runs.
reset_runs
write_runs "${code_sha}" success Test E2E Performance
verify issue-missing-issues "${issue2_sha}"
expect_rc issue-missing-issues 1
expect_out issue-missing-issues 'Issues=missing' out

# A failed Issues run fails the commit even when the code runs are green.
reset_runs
write_runs "${code_sha}" success Test E2E Performance
write_runs "${issue2_sha}" failure Issues
verify issue-failed-issues "${issue2_sha}"
expect_rc issue-failed-issues 1
expect_out issue-failed-issues 'Issues workflow failed' err

# The walk stops at the first commit that changes anything else: the base's runs never count.
reset_runs
write_runs "${base_sha}" success Test E2E Performance
write_runs "${issue2_sha}" success Issues
verify issue-stops-at-code "${issue2_sha}"
expect_rc issue-stops-at-code 1
expect_out issue-stops-at-code 'Test=missing' out

# Moving a file out of Sources/ into issues/ is not issue-only (--no-renames sees the old path).
reset_runs
write_runs "${issue2_sha}" success Test E2E Performance Issues
verify move-out-of-sources "${moved_sha}"
expect_rc move-out-of-sources 1
expect_out move-out-of-sources 'Test=missing' out

# The skipped path must stay the same in the workflows and in verify-agent-push.
grep -Fqx "skip_prefix='issues/'" "${SCRIPT_DIR}/verify-agent-push" || fail "verify-agent-push skip_prefix is not issues/"
for workflow in test e2e performance; do
  count="$(grep -Fc "paths-ignore: ['issues/**']" "${REPO_ROOT}/.github/workflows/${workflow}.yml" || true)"
  [ "${count}" = 2 ] || fail "${workflow}.yml must ignore exactly issues/** on push and pull_request (found ${count})"
done
# verify-agent-push requires Issues on every commit, so issues.yml must not filter by path.
if grep -Eq '^[[:space:]]*paths(-ignore)?:' "${REPO_ROOT}/.github/workflows/issues.yml"; then
  fail "issues.yml must run on every push (no paths / paths-ignore)"
fi

echo "Agent verifier tests passed."
