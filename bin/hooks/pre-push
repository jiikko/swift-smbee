#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
cd "${REPO_ROOT}"

gate_sha=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # Deleting a remote ref has no commits to validate.
  [ "${local_sha}" != "0000000000000000000000000000000000000000" ] || continue

  if [ "${remote_sha:-}" = "0000000000000000000000000000000000000000" ] || [ -z "${remote_sha:-}" ]; then
    # New branches have no remote base; inspect every commit reachable from the tip.
    files=$(git log --format= --name-only "${local_sha}" 2>/dev/null || true)
  else
    files=$(git diff --name-only "${remote_sha}" "${local_sha}" 2>/dev/null || true)
  fi
  if printf '%s\n' "${files}" | grep -q '^Sources/SMBee/'; then
    gate_sha="${local_sha}"
    break
  fi
done

[ -n "${gate_sha}" ] || exit 0

if [ "${SMBEE_SKIP_E2E_GATE:-0}" = "1" ]; then
  printf 'WARNING: skipping SMBee E2E pre-push gate (SMBEE_SKIP_E2E_GATE=1).\n' >&2
  exit 0
fi

# The marker is keyed to the Sources/SMBee subtree hash of the pushed tip, so
# follow-up commits that do not touch wire code keep an existing marker valid.
tree="$(git rev-parse "${gate_sha}:Sources/SMBee")"
if [ ! -e "./tmp/e2e-verified-tree-${tree}" ]; then
  printf 'Push rejected: Sources/SMBee/ changed, but its subtree (%s) has no E2E smoke marker.\n' "${tree}" >&2
  printf 'Run bin/e2e/smoke-all (or make smoke) on the committed tree, then push again.\n' >&2
  exit 1
fi
