#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

cd "${REPO_ROOT}"

printf '== E2E smoke: smb302-encrypted-required ==\n'
SMBEE_E2E_PROFILE=smb302-encrypted-required \
SAMBA_CONFIG=test/e2e/smb/smb302-encrypted-required.conf \
  bin/e2e/container-samba.sh

printf '\n== E2E smoke: smb311-signing-required ==\n'
SMBEE_E2E_PROFILE=smb311-signing-required \
SAMBA_CONFIG=test/e2e/smb/smb311-signing-required.conf \
  bin/e2e/container-samba.sh

printf '\n== E2E smoke: smb422-reparse ==\n'
SAMBA_BASE_IMAGE=debian:13-slim \
SMBEE_E2E_PROFILE=smb422-reparse \
SMBEE_E2E_TEST_FILTER=SMBReparsePointE2ETests \
SMBEE_E2E_SKIP_EXTRA_API_TESTS=1 \
SMBEE_E2E_SKIP_CLI_SMOKE=1 \
SAMBA_CONFIG=test/e2e/smb/smb422-reparse.conf \
  bin/e2e/container-samba.sh

if ! git diff --quiet HEAD -- Sources/SMBee; then
  printf 'ERROR: Sources/SMBee has uncommitted changes; commit them before running smoke-all\n' >&2
  printf '(the marker certifies the committed Sources/SMBee subtree, not the dirty worktree).\n' >&2
  exit 1
fi

mkdir -p tmp
# Key the marker to the Sources/SMBee subtree hash: docs-only commits keep it valid,
# any wire-code change invalidates it.
tree="$(git rev-parse HEAD:Sources/SMBee)"
touch "./tmp/e2e-verified-tree-${tree}"
printf '\nE2E smoke verified Sources/SMBee tree: %s\n' "${tree}"
