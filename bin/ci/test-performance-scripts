    '- first invocation (includes Release build): 666.1 MiB' \
    '- baseline invocations: 2'
}

test_parser_rejects_malformed() {
  local scenario_dir
  scenario_dir="$(new_scenario_dir)"
  local log_file="${scenario_dir}/resource.log"
  write_canonical_log "${log_file}"

  sed '/^PERF_RESOURCE_SAMPLE operation=read_stream run=1 /s/ iterations=20//' "${log_file}" > "${scenario_dir}/missing-field.log"
  expect_parser_failure "${scenario_dir}" missing-field "${scenario_dir}/missing-field.log"
  sed 's/elapsed_ms=245.000/elapsed_ms=not-a-number/' "${log_file}" > "${scenario_dir}/invalid-number.log"
  expect_parser_failure "${scenario_dir}" invalid-number "${scenario_dir}/invalid-number.log"
  sed 's/PERF_METRIC deterministic_command_count actual=12 expected=12/PERF_METRIC deterministic_command_count actual=12/' "${log_file}" > "${scenario_dir}/malformed-metric.log"
  expect_parser_failure "${scenario_dir}" malformed-metric "${scenario_dir}/malformed-metric.log"
  sed 's/PERF_METRIC deterministic_command_count actual=12 expected=12/PERF_METRIC deterministic_command_count actual=-1.25e+2 expected=2.5E2/' "${log_file}" > "${scenario_dir}/numeric-metric.log"
  "${SCRIPT_DIR}/parse-resource-performance" "${scenario_dir}/numeric-metric.log" >/dev/null
  cp "${log_file}" "${scenario_dir}/malformed.log"
  echo 'PERF_RESOURCE_SAMPLE malformed' >> "${scenario_dir}/malformed.log"
  expect_parser_failure "${scenario_dir}" malformed "${scenario_dir}/malformed.log"
  grep -v '^PERF_FORMAT ' "${log_file}" > "${scenario_dir}/missing-format.log"
  expect_parser_failure "${scenario_dir}" missing-format "${scenario_dir}/missing-format.log"
  sed 's/PERF_FORMAT version=1/PERF_FORMAT version=2/' "${log_file}" > "${scenario_dir}/wrong-format.log"
  expect_parser_failure "${scenario_dir}" wrong-format "${scenario_dir}/wrong-format.log"
  sed '/^PERF_RUN_COMPLETE operation=read_stream/d' "${log_file}" > "${scenario_dir}/missing-completion.log"
  expect_parser_failure "${scenario_dir}" missing-completion "${scenario_dir}/missing-completion.log"
  awk '/PERF_RESOURCE read_stream.throughput_mib_s value=737.364/ { print; print "PERF_RESOURCE read_stream.throughput_mib_s value=737.364 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release"; next } { print }' "${log_file}" > "${scenario_dir}/duplicate-metric.log"
  expect_parser_failure "${scenario_dir}" duplicate-metric "${scenario_dir}/duplicate-metric.log"
  awk '/PERF_RUN_COMPLETE operation=read_stream/ { print; print "PERF_RESOURCE_SAMPLE operation=read_stream run=1 elapsed_ms=245.000 throughput_mib_s=653.061 user_cpu_ms=200.000 system_cpu_ms=4.000 max_rss_kb=286048 total_size_mib=160 iterations=20"; next } { print }' "${log_file}" > "${scenario_dir}/resource-after-completion.log"
  expect_parser_failure "${scenario_dir}" resource-after-completion "${scenario_dir}/resource-after-completion.log"
  awk '/PERF_RUN_COMPLETE operation=read_stream/ { print; print "PERF_RESOURCE read_stream.throughput_mib_s value=737.364 size_mib=160 runs=5 iterations=20 throughput_floor_mib_s=400 config=release"; next } { print }' "${log_file}" > "${scenario_dir}/summary-after-completion.log"
  expect_parser_failure "${scenario_dir}" summary-after-completion "${scenario_dir}/summary-after-completion.log"
  # PERF_FORMAT after the previous operation's completion is legitimate (each
  # resource test prints one), so the failure case is FORMAT after ALL
  # operations of the baseline run completed.
  awk '/PERF_RUN_COMPLETE operation=write_stream/ { print; print "PERF_FORMAT version=1"; next } { print }' "${log_file}" > "${scenario_dir}/format-after-completion.log"
  expect_parser_failure "${scenario_dir}" format-after-completion "${scenario_dir}/format-after-completion.log"
  cp "${log_file}" "${scenario_dir}/duplicate-baseline.log"
  echo 'PERF_BASELINE_RUN run=1 total=2' >> "${scenario_dir}/duplicate-baseline.log"
  expect_parser_failure "${scenario_dir}" duplicate-baseline "${scenario_dir}/duplicate-baseline.log"
  sed 's/PERF_BASELINE_RUN run=2 total=2/PERF_BASELINE_RUN run=3 total=2/' "${log_file}" > "${scenario_dir}/noncontinuous-baseline.log"
  expect_parser_failure "${scenario_dir}" noncontinuous-baseline "${scenario_dir}/noncontinuous-baseline.log"
  grep -v 'write_stream' "${log_file}" > "${scenario_dir}/missing-operation.log"
  expect_parser_failure "${scenario_dir}" missing-operation "${scenario_dir}/missing-operation.log"
  awk '/PERF_CMAC_SCALING_SAMPLE size_mib=4 chunks=64 iterations=128 run=5 / { seen++; if (seen == 1) next } { print }' \
    "${log_file}" > "${scenario_dir}/missing-cmac-sample.log"
  expect_parser_failure "${scenario_dir}" missing-cmac-sample "${scenario_dir}/missing-cmac-sample.log"
  awk '/^PERF_CMAC_SCALING size_mib=4 / && !seen { print $0 " unexpected=1"; seen=1; next } { print }' \
    "${log_file}" > "${scenario_dir}/unexpected-cmac-field.log"
  expect_parser_failure "${scenario_dir}" unexpected-cmac-field "${scenario_dir}/unexpected-cmac-field.log"
  awk '
    /^PERF_BASELINE_RUN run=2 / { second=1 }
    second && /^PERF_CMAC_SCALING/ { next }
    { print }
  ' "${log_file}" > "${scenario_dir}/missing-cmac-baseline.log"
  expect_parser_failure "${scenario_dir}" missing-cmac-baseline "${scenario_dir}/missing-cmac-baseline.log"
  cp "${log_file}" "${scenario_dir}/duplicate-env.log"
  echo 'PERF_ENV kernel Duplicate kernel value' >> "${scenario_dir}/duplicate-env.log"
  expect_parser_failure "${scenario_dir}" duplicate-env "${scenario_dir}/duplicate-env.log"
}

