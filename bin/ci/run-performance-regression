#!/usr/bin/env bash
# This is a standalone, manual utility for running the Debug deterministic
# contract in SMBeePerformanceRegressionTests inside Docker. It is not called
# by the workflow: Release resource measurements use run-resource-performance
# as a separate path. Do not use this script to measure resource metrics.
# The command intentionally omits -c release because this contract validates
# deterministic behavior, rather than the Linux Release resource contract.
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
SWIFT_IMAGE="${SWIFT_IMAGE:-$("${SCRIPT_DIR}/swift-image")}"

cd "${REPO_ROOT}"
docker run --rm "${SWIFT_IMAGE}" swift --version
docker run --rm \
  -v "${REPO_ROOT}:/workspace" \
  -w /workspace \
  "${SWIFT_IMAGE}" \
  swift test --filter SMBeePerformanceRegressionTests
