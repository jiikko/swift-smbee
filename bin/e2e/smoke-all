#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

cd "${REPO_ROOT}"

if [ -n "$(git status --porcelain --untracked-files=all -- Sources/SMBee)" ]; then
  printf 'ERROR: Sources/SMBee has uncommitted changes; commit them before running smoke-all\n' >&2
  printf '(the marker certifies the committed Sources/SMBee subtree, not the dirty worktree).\n' >&2
  exit 1
fi

# Snapshot the subtree identity up front: the marker must describe the code that the
# profiles below actually exercised, so a mid-run commit invalidates the run (issues/079).
tree="$(git rev-parse HEAD:Sources/SMBee)"

printf '== E2E smoke: smb302-encrypted-required ==\n'
SMBEE_E2E_PROFILE=smb302-encrypted-required \
SAMBA_CONFIG=test/e2e/smb/smb302-encrypted-required.conf \
  bin/e2e/container-samba.sh

printf '\n== E2E smoke: smb311-signing-required ==\n'
SMBEE_E2E_PROFILE=smb311-signing-required \
SAMBA_CONFIG=test/e2e/smb/smb311-signing-required.conf \
  bin/e2e/container-samba.sh

printf '\n== E2E smoke: smb422-reparse ==\n'
SAMBA_BASE_IMAGE=debian:13-slim \
SMBEE_E2E_PROFILE=smb422-reparse \
SMBEE_E2E_TEST_FILTER=SMBReparsePointE2ETests \
SMBEE_E2E_SKIP_EXTRA_API_TESTS=1 \
SMBEE_E2E_SKIP_CLI_SMOKE=1 \
SAMBA_CONFIG=test/e2e/smb/smb422-reparse.conf \
  bin/e2e/container-samba.sh

mkdir -p tmp
# The run is only valid if the subtree the profiles exercised is still what HEAD points
# at (and still clean); otherwise refuse to certify it.
if [ "$(git rev-parse HEAD:Sources/SMBee)" != "${tree}" ] ||
   [ -n "$(git status --porcelain --untracked-files=all -- Sources/SMBee)" ]; then
  printf 'ERROR: Sources/SMBee changed while smoke-all was running; not writing a marker.\n' >&2
  exit 1
fi
# Key the marker to the Sources/SMBee subtree hash: docs-only commits keep it valid,
# any wire-code change invalidates it. The pre-push gate only tests existence, so the
# marker body is free to carry an audit trail (issues/079): when, which HEAD, which
# profiles were exercised. Markers are deliberately never pruned — deleting one would
# silently change the push-gate behavior for older trees; only the bulky per-tree logs
# (written by smoke-agent) are subject to retention.
{
  printf 'verified_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  printf 'head_commit=%s\n' "$(git rev-parse HEAD)"
  printf 'sources_tree=%s\n' "${tree}"
  printf 'profiles=smb302-encrypted-required,smb311-signing-required,smb422-reparse\n'
} > "./tmp/e2e-verified-tree-${tree}"
printf '\nE2E smoke verified Sources/SMBee tree: %s\n' "${tree}"
