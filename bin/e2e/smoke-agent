#!/usr/bin/env bash
set -euo pipefail
unset CDPATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
log_file="${SMBEE_SMOKE_LOG:-${REPO_ROOT}/tmp/e2e-smoke-latest.log}"

cd "${REPO_ROOT}"
mkdir -p "$(dirname "${log_file}")"

echo "Running required Samba smoke profiles (full log: ${log_file})"
if "${SCRIPT_DIR}/smoke-all" 2>&1 \
  | tee "${log_file}" \
  | awk '
      /^== E2E smoke:/ ||
      /^Starting Samba container/ ||
      /^Samba is ready/ ||
      /^Test Suite '\''Selected tests'\'' (passed|failed)/ ||
      /^Local container E2E completed successfully/ ||
      /^E2E smoke verified Sources\/SMBee tree:/ ||
      /^ERROR:/ {
        print
        fflush()
      }
    '; then
  # Keep a per-tree copy of the full log next to the marker (issues/079) so the
  # audit trail for earlier wire commits survives later runs overwriting the
  # "latest" log. The tree hash is taken from smoke-all's own output so the log
  # copy can never diverge from the marker it documents. Only these bulky logs
  # are pruned (newest SMBEE_SMOKE_RETAIN kept); markers are never pruned.
  tree="$(sed -n 's/^E2E smoke verified Sources\/SMBee tree: //p' "${log_file}" | tail -1)"
  if [ -n "${tree}" ]; then
    cp "${log_file}" "${REPO_ROOT}/tmp/e2e-smoke-tree-${tree}.log"
    retain="${SMBEE_SMOKE_RETAIN:-10}"
    # find -exec ls -t {} + runs nothing when no log matches, so an empty tmp/
    # cannot fail the pipeline under set -o pipefail (issues/079 refutation P1).
    find "${REPO_ROOT}/tmp" -maxdepth 1 -name 'e2e-smoke-tree-*.log' -exec ls -t {} + 2>/dev/null \
      | tail -n "+$((retain + 1))" \
      | while IFS= read -r stale; do rm -f "${stale}"; done
  fi
  echo "Samba smoke passed. Full log: ${log_file}"
else
  status=$?
  echo >&2
  echo "Samba smoke failed (exit ${status}). Highlights:" >&2
  if ! grep -Ei \
    '(^|[^[:alpha:]])(error|failed|failure|fatal|exception|assert|timed out|timeout)([^[:alpha:]]|$)' \
    "${log_file}" | tail -120 >&2; then
    tail -120 "${log_file}" >&2
  fi
  echo "Full log: ${log_file}" >&2
  exit "${status}"
fi
